}

_on_off() {
    (( ${1:-1} )) && printf '\033[32mon\033[0m ' || printf '\033[31moff\033[0m'
}

_set_config() {
    local key="$1" val="$2"
    mkdir -p "$CONFIG_DIR"
    touch "$CONFIG_FILE"
    if grep -q "^${key}=" "$CONFIG_FILE" 2>/dev/null; then
        sed -i '' "s|^${key}=.*|${key}=${val}|" "$CONFIG_FILE" 2>/dev/null || \
        sed -i "s|^${key}=.*|${key}=${val}|" "$CONFIG_FILE" 2>/dev/null || true
    else
        printf '%s=%s\n' "$key" "$val" >> "$CONFIG_FILE"
    fi
}

statd_config() {
    mkdir -p "$CONFIG_DIR"
    local subcmd="${1:-}"
    shift || true

    case "$subcmd" in
        disable|off)
            local target="${1:-}"
            target=$(echo "$target" | tr '[:upper:]' '[:lower:]')
            case "$target" in
                ld|load)     _set_config "SHOW_LD" "0" ;;
                bat|battery) _set_config "SHOW_BAT" "0" ;;
                swp|swap)    _set_config "SHOW_SWP" "0" ;;
                dsk|disk)    _set_config "SHOW_DSK" "0" ;;
                cpu)         _set_config "SHOW_CPU" "0" ;;
                gpu)         _set_config "SHOW_GPU" "0" ;;
                ram|mem)     _set_config "SHOW_RAM" "0" ;;
                llm)         _set_config "SHOW_LLM" "0" ;;
                net|network) _set_config "SHOW_NET" "0" ;;
                full|fit)    _set_config "FULL_WIDTH" "0" ;;
                *)
                    printf 'Unknown view: %s (choose: ld, bat, swp, dsk, cpu, gpu, ram, net, llm, full)\n' "$target" >&2
                    return 1
                    ;;
            esac
            printf '\033[32m+\033[0m  Disabled %s in %s\n' "$target" "$CONFIG_FILE"
            ;;
        enable|on)
            local target="${1:-}"
            target=$(echo "$target" | tr '[:upper:]' '[:lower:]')
            case "$target" in
                ld|load)     _set_config "SHOW_LD" "1" ;;
                bat|battery) _set_config "SHOW_BAT" "1" ;;
                swp|swap)    _set_config "SHOW_SWP" "1" ;;
                dsk|disk)    _set_config "SHOW_DSK" "1" ;;
                cpu)         _set_config "SHOW_CPU" "1" ;;
                gpu)         _set_config "SHOW_GPU" "1" ;;
                ram|mem)     _set_config "SHOW_RAM" "1" ;;
                llm)         _set_config "SHOW_LLM" "1" ;;
                net|network) _set_config "SHOW_NET" "1" ;;
                full|fit)    _set_config "FULL_WIDTH" "1" ;;
                *)
                    printf 'Unknown view: %s (choose: ld, bat, swp, dsk, cpu, gpu, ram, net, llm, full)\n' "$target" >&2
                    return 1
                    ;;
            esac
            printf '\033[32m+\033[0m  Enabled %s in %s\n' "$target" "$CONFIG_FILE"
            ;;
        set)
            local key="${1:-}" val="${2:-}"
            if [ -z "$key" ] || [ -z "$val" ]; then
                printf 'Usage: statd config set <KEY> <VALUE>\n' >&2
                return 1
            fi
            _set_config "$key" "$val"
            printf '\033[32m+\033[0m  Set %s=%s in %s\n' "$key" "$val" "$CONFIG_FILE"
            ;;
        path)
            printf '%s\n' "$CONFIG_FILE"
            ;;
        edit)
            "${EDITOR:-nano}" "$CONFIG_FILE"
            ;;
        reset)
            rm -f "$CONFIG_FILE"
            printf '\033[32m+\033[0m  Reset configuration (removed %s)\n' "$CONFIG_FILE"
            ;;
        ""|show|list)
            printf '\033[1mstatd configuration\033[0m\n'
            printf 'Config file: %s\n\n' "$CONFIG_FILE"
            printf 'Views:\n'
            printf '  CPU: %s    GPU: %s    RAM: %s    SWP: %s\n' \
                "$(_on_off "$SHOW_CPU")" "$(_on_off "$SHOW_GPU")" "$(_on_off "$SHOW_RAM")" "$(_on_off "$SHOW_SWP")"
            printf '  DSK: %s    LD:  %s    BAT: %s    NET: %s\n\n' \
                "$(_on_off "$SHOW_DSK")" "$(_on_off "$SHOW_LD")" "$(_on_off "$SHOW_BAT")" "$(_on_off "$SHOW_NET")"
            printf 'Display:\n'
            printf '  Full Width: %s (auto on <= 50 cols)\n\n' "$(_on_off "$FULL_WIDTH")"
            printf 'Commands:\n'
            printf '  statd config disable <view>   (turn off view: ld, bat, swp, dsk, cpu, gpu, ram, net, full)\n'
            printf '  statd config enable <view>    (turn on view: ld, bat, swp, dsk, cpu, gpu, ram, net, full)\n'
            printf '  statd config enable <view>    (turn on view: ld, bat, swp, dsk, cpu, gpu, ram, full)\n'
            printf '  statd config set <KEY> <VAL>  (set any setting, e.g. INTERVAL 2)\n'
            printf '  statd config edit             (open in editor)\n'
            printf '  statd config reset            (reset to defaults)\n'
            ;;
        *)
            printf 'Unknown config command: %s (see "statd config")\n' "$subcmd" >&2
            return 1
            ;;
    esac
}

statd_check_update() {
    printf 'statd %s — checking for updates...\n' "$VERSION"
    local latest_commit=""
    if command -v curl >/dev/null 2>&1; then
        latest_commit=$(curl -fsSL -H "User-Agent: statd" "https://api.github.com/repos/Jaseunda/statd/commits/main" 2>/dev/null | grep '"sha"' | head -1 | cut -d'"' -f4 | cut -c1-7)
    elif command -v wget >/dev/null 2>&1; then
        latest_commit=$(wget -qO- --user-agent="statd" "https://api.github.com/repos/Jaseunda/statd/commits/main" 2>/dev/null | grep '"sha"' | head -1 | cut -d'"' -f4 | cut -c1-7)
    fi
    if [ -n "$latest_commit" ]; then
        printf '  Latest commit on main: %s\n' "$latest_commit"
        printf '  Run "statd --update" to update to the latest version.\n'
    else
        printf '  Unable to check remote commit. Run "statd --update" to attempt update.\n'
    fi
}

_statd_core_update() {
    local script_path
    script_path="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
    printf '\033[1mstatd update\033[0m (current version: %s)\n\n' "$VERSION"

    # 1. If running inside a git checkout, update via git
    if git -C "$script_path" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
        local git_root
        git_root=$(git -C "$script_path" rev-parse --show-toplevel 2>/dev/null)
        printf '  \033[32m+\033[0m  Git repository detected at: %s\n' "$git_root"
        printf '  \033[32m+\033[0m  Pulling latest changes from remote...\n'
        if git -C "$git_root" pull; then
            printf '\n  \033[1;32mstatd updated successfully via git.\033[0m\n'
            return 0
        else
            printf '\n  \033[31mx\033[0m  git pull failed.\n' >&2
            return 1
        fi
    fi

    # 2. Installed binary: update in-place using installer
    local prefix_dir
    if [[ "$script_path" == */bin ]]; then
        prefix_dir="$(dirname "$script_path")"
    else
        prefix_dir="${PREFIX:-$HOME/.local}"
    fi

    printf '  Fetching latest installer from GitHub...\n'
    local branch="${BRANCH:-main}"
    local installer_url="https://raw.githubusercontent.com/Jaseunda/statd/${branch}/install.sh"
    local tmp_installer
    tmp_installer=$(mktemp "${TMPDIR:-/tmp}/statd_update_XXXXXX.sh" 2>/dev/null || mktemp /tmp/statd_update_XXXXXX.sh)

    if command -v curl >/dev/null 2>&1; then
        curl -fsSL "$installer_url" -o "$tmp_installer" || {
            rm -f "$tmp_installer"
            printf '  \033[31mx\033[0m  Failed to download installer from %s\n' "$installer_url" >&2
            return 1
        }
    elif command -v wget >/dev/null 2>&1; then
        wget -qO "$tmp_installer" "$installer_url" || {
            rm -f "$tmp_installer"
            printf '  \033[31mx\033[0m  Failed to download installer from %s\n' "$installer_url" >&2
            return 1
        }
    else
        rm -f "$tmp_installer"
        printf '  \033[31mx\033[0m  curl or wget is required to update.\n' >&2
        return 1
    fi

    printf '  \033[32m+\033[0m  Updating installation at %s ...\n\n' "$prefix_dir"
    PREFIX="$prefix_dir" bash "$tmp_installer" --prefix="$prefix_dir" --update --yes
    local rc=$?
    rm -f "$tmp_installer"

    # If this script was executed directly from a custom location outside bin (e.g. ~/statd),
    # update this file directly using dist/statd so it never stays stale
    local this_script
    this_script="$(cd "$(dirname "${BASH_SOURCE[0]}")" 2>/dev/null && pwd)/$(basename "${BASH_SOURCE[0]}")"
    if [ -w "$this_script" ] && [[ "$this_script" != */bin/* ]]; then
        local standalone_url="https://raw.githubusercontent.com/Jaseunda/statd/${branch}/dist/statd"
        printf '  \033[32m+\033[0m  Updating standalone script at %s ...\n' "$this_script"
        if command -v curl >/dev/null 2>&1; then
            curl -fsSL "$standalone_url" -o "$this_script.tmp" 2>/dev/null && mv "$this_script.tmp" "$this_script" && chmod +x "$this_script"
        elif command -v wget >/dev/null 2>&1; then
            wget -qO "$this_script.tmp" "$standalone_url" 2>/dev/null && mv "$this_script.tmp" "$this_script" && chmod +x "$this_script"
        fi
    fi

    return $rc
}

get_plugin_version() {
    local name="$1"
    local bin
    bin=$(find_plugin_bin "$name" 2>/dev/null || true)
    [ -z "$bin" ] && return 1
    local ver
    ver=$(sed -n 's/^VERSION=["'\'']\([^"'\'']*\).*/\1/p' "$bin" 2>/dev/null | head -1)
    if [ -z "$ver" ]; then
        ver=$("$bin" -v 2>/dev/null | awk '{print $NF}' || true)
    fi
    printf '%s' "$ver"
}

get_remote_plugin_version() {
    local name="$1"
    local ver=""
    local local_file="$(dirname "$STATD_LIB_DIR")/plugins/$name/statd-$name"
    [ ! -f "$local_file" ] && local_file="$(pwd)/plugins/$name/statd-$name"
    if [ -f "$local_file" ]; then
        ver=$(sed -n 's/^VERSION=["'\'']\([^"'\'']*\).*/\1/p' "$local_file" 2>/dev/null | head -1)
    fi
    if [ -z "$ver" ] && command -v curl >/dev/null 2>&1; then
        local url="https://raw.githubusercontent.com/Jaseunda/statd/main/plugins/$name/statd-$name"
        ver=$(curl -s --connect-timeout 2 --max-time 3 -fsSL "$url" 2>/dev/null | head -n 30 | sed -n 's/^VERSION=["'\'']\([^"'\'']*\).*/\1/p' | head -1)
    fi
    printf '%s' "$ver"
}

get_remote_statd_version() {
    local ver=""
    if command -v curl >/dev/null 2>&1; then
        local url="https://raw.githubusercontent.com/Jaseunda/statd/main/statd"
        ver=$(curl -s --connect-timeout 2 --max-time 3 -fsSL "$url" 2>/dev/null | head -n 50 | sed -n 's/^VERSION=["'\'']\([^"'\'']*\).*/\1/p' | head -1)
    fi
    printf '%s' "$ver"
}

statd_plugin_update() {
    local target="all"
    local force=0
    local arg
    for arg in "$@"; do
        if [ "$arg" = "--force" ] || [ "$arg" = "-f" ]; then
            force=1
        elif [ -n "$arg" ] && [ "$target" = "all" ]; then
            target="$arg"
        fi
    done

    local plugins_to_update=()
    if [ "$target" = "all" ] || [ "$target" = "plugins" ] || [ -z "$target" ]; then
        local p
        for p in "theme" "api"; do
            if find_plugin_bin "$p" >/dev/null 2>&1; then
                plugins_to_update+=("$p")
            fi
        done
        local d
        for d in "$STATD_LIB_DIR/plugins/"* "$CONFIG_DIR/plugins/"*; do
            if [ -d "$d" ]; then
                local b="$(basename "$d")"
                if [[ ! " ${plugins_to_update[*]} " =~ " ${b} " ]] && find_plugin_bin "$b" >/dev/null 2>&1; then
                    plugins_to_update+=("$b")
                fi
            fi
        done

        if [ ${#plugins_to_update[@]} -eq 0 ]; then
            printf '\n  \033[33m!\033[0m  No plugins are currently installed.\n'
            printf '     Install plugins with: \033[1mstatd install <name>\033[0m\n'
            printf '     List available:       \033[1mstatd plugins\033[0m\n\n'
            return 0
        fi
    else
        if ! find_plugin_bin "$target" >/dev/null 2>&1; then
            printf '\n  \033[33m!\033[0m  Plugin "%s" is not installed.\n' "$target"
            printf '     Install it with: \033[1mstatd install %s\033[0m\n\n' "$target"
            return 1
        fi
        plugins_to_update=("$target")
    fi

    printf '\n  \033[1mUpdating StatD Plugins\033[0m\n'
    printf '  \033[2m─────────────────────────────────────────────────────────────\033[0m\n'

    local updated_count=0
    local p
    for p in "${plugins_to_update[@]}"; do
        local cur_ver
        cur_ver=$(get_plugin_version "$p" || echo "unknown")
        local remote_ver
        remote_ver=$(get_remote_plugin_version "$p" || true)

        printf '  \033[1m%-10s\033[0m [installed: v%s]' "$p" "$cur_ver"
        if [ -n "$remote_ver" ]; then
            printf ' [latest: v%s]' "$remote_ver"
        fi
        printf '\n'

        if [ "$force" != "1" ] && [ -n "$remote_ver" ] && [ "$cur_ver" = "$remote_ver" ]; then
            printf '  \033[32m●\033[0m  Already up to date (v%s).\n\n' "$cur_ver"
            continue
        fi

        local cur_bin
        cur_bin=$(find_plugin_bin "$p")
        local target_dir
        target_dir="$(dirname "$cur_bin")"
        if [ ! -w "$target_dir" ] 2>/dev/null; then
            target_dir="$CONFIG_DIR/plugins/$p"
        fi
        mkdir -p "$target_dir"

        local success=0
        local repo_plugin_dir="$(dirname "$STATD_LIB_DIR")/plugins/$p"
        local cwd_plugin_dir="$(pwd)/plugins/$p"
        if [ "$target_dir" = "$cwd_plugin_dir" ] || [ "$target_dir" = "$repo_plugin_dir" ]; then
            chmod +x "$target_dir/statd-$p" 2>/dev/null || true
            success=1
        elif [ -d "$cwd_plugin_dir" ] && [ -f "$cwd_plugin_dir/statd-$p" ]; then
            cp -R "$cwd_plugin_dir/"* "$target_dir/" 2>/dev/null || true
            chmod +x "$target_dir/statd-$p" 2>/dev/null || true
            success=1
        elif [ -d "$repo_plugin_dir" ] && [ -f "$repo_plugin_dir/statd-$p" ]; then
            cp -R "$repo_plugin_dir/"* "$target_dir/" 2>/dev/null || true
            chmod +x "$target_dir/statd-$p" 2>/dev/null || true
            success=1
        else
            local base_url="https://raw.githubusercontent.com/Jaseunda/statd/main/plugins/$p"
            printf '     Downloading update from GitHub...\n'
            if curl -fsSL "$base_url/statd-$p" -o "$target_dir/statd-$p"; then
                chmod +x "$target_dir/statd-$p"
                curl -fsSL "$base_url/README.md" -o "$target_dir/README.md" 2>/dev/null || true
                success=1
            fi
        fi

        if (( success )); then
            local new_ver
            new_ver=$(get_plugin_version "$p" || echo "$remote_ver")
            if [ "$cur_ver" != "$new_ver" ]; then
                printf '  \033[32m+\033[0m  \033[1;32mUpdated successfully:\033[0m v%s ➔ v%s\n\n' "$cur_ver" "$new_ver"
            else
                printf '  \033[32m+\033[0m  \033[32mReinstalled / verified latest:\033[0m v%s\n\n' "$new_ver"
            fi
            (( updated_count++ ))
        else
            printf '  \033[31mx\033[0m  Failed to update plugin "%s"\n\n' "$p"
        fi
    done

    printf '  \033[2m─────────────────────────────────────────────────────────────\033[0m\n'
    printf '  Updated %d plugin(s).\n\n' "$updated_count"
    return 0
}

statd_update() {
    local target="${1:-core}"
    if [ "$target" = "plugins" ] || [ "$target" = "plugin" ]; then
        shift || true
        statd_plugin_update "$@"
        return $?
    elif [ "$target" = "all" ]; then
        printf '\n\033[1m=== Updating StatD Core & Plugins ===\033[0m\n\n'
        _statd_core_update
        local rc=$?
        statd_plugin_update "all"
        return $rc
    elif [ "$target" = "api" ] || [ "$target" = "theme" ]; then
        shift || true
        statd_plugin_update "$target" "$@"
        return $?
    fi

    # Core update
    _statd_core_update "$@"
}

statd_about() {
    local opt="${1:-}"
    if [ "$opt" = "--json" ]; then
        local statd_path=$(command -v statd 2>/dev/null || echo "$0")
        local statd_remote=$(get_remote_statd_version)
        local theme_ver=$(get_plugin_version "theme" 2>/dev/null || echo "")
        local theme_bin=$(find_plugin_bin "theme" 2>/dev/null || echo "")
        local theme_remote=$(get_remote_plugin_version "theme" 2>/dev/null || echo "")
        local api_ver=$(get_plugin_version "api" 2>/dev/null || echo "")
        local api_bin=$(find_plugin_bin "api" 2>/dev/null || echo "")
        local api_remote=$(get_remote_plugin_version "api" 2>/dev/null || echo "")
        local mcp_ver=$(get_plugin_version "mcp" 2>/dev/null || echo "")
        local mcp_bin=$(find_plugin_bin "mcp" 2>/dev/null || echo "")
        local mcp_remote=$(get_remote_plugin_version "mcp" 2>/dev/null || echo "")
        cat <<EOF
{
  "statd": {
    "version": "$VERSION",
    "latest": "${statd_remote:-unknown}",
    "executable": "$statd_path",
    "lib_dir": "$STATD_LIB_DIR",
    "config": "$CONFIG_FILE"
  },
  "plugins": {
    "theme": {
      "installed": $([ -n "$theme_bin" ] && echo true || echo false),
      "version": "${theme_ver:-null}",
      "latest": "${theme_remote:-null}",
      "path": "${theme_bin:-null}"
    },
    "api": {
      "installed": $([ -n "$api_bin" ] && echo true || echo false),
      "version": "${api_ver:-null}",
      "latest": "${api_remote:-null}",
      "path": "${api_bin:-null}"
    },
    "mcp": {
      "installed": $([ -n "$mcp_bin" ] && echo true || echo false),
      "version": "${mcp_ver:-null}",
      "latest": "${mcp_remote:-null}",
      "path": "${mcp_bin:-null}"
    }
  }
}
EOF
        return 0
    fi

    if [ "$opt" = "--update" ] || [ "$opt" = "-u" ]; then
        statd_update "all"
        opt=""
    fi

    local interactive=0
    if [ -t 0 ] && [ -t 1 ] && [ "$opt" != "--no-interactive" ] && [ "$opt" != "--check" ]; then
        interactive=1
    fi

    while :; do
        local term_w=$(tput cols 2>/dev/null || echo 80)
        local term_h=$(tput lines 2>/dev/null || echo 24)

        local os_name="Unknown OS"
        if [[ "$OSTYPE" == darwin* ]]; then
            local p_name=$(sw_vers -productName 2>/dev/null || echo "macOS")
            local p_ver=$(sw_vers -productVersion 2>/dev/null || echo "")
            os_name="$p_name $p_ver"
        elif [ -f /etc/os-release ]; then
            os_name=$(. /etc/os-release && echo "${PRETTY_NAME:-$NAME}")
        else
            os_name="$(uname -s)"
        fi
        local arch="$(uname -m)"

        local remote_statd_ver
        remote_statd_ver=$(get_remote_statd_version)
        local statd_status_str=""
        if [ -n "$remote_statd_ver" ] && [ "$remote_statd_ver" != "$VERSION" ]; then
            statd_status_str="\033[1;33m▲ update available: v${remote_statd_ver}\033[0m"
        elif [ -n "$remote_statd_ver" ]; then
            statd_status_str="\033[32m● up to date\033[0m"
        else
            statd_status_str="\033[2m● installed\033[0m"
        fi

        local clean_conf
        clean_conf=$(echo "$CONFIG_FILE" | sed "s|^$HOME|~|")

        (( interactive )) && printf '\033[H\033[2J'

        printf '\n'
        printf '  \033[1;37mstatd\033[0m \033[1;36mv%s\033[0m — terminal system stats HUD\n' "$VERSION"
        printf '  \033[2mhttps://github.com/Jaseunda/statd\033[0m\n\n'

        printf '  \033[1;34mCORE & SYSTEM\033[0m\n'
        printf '  \033[2m─────────────────────────────────────────────────────────────\033[0m\n'
        printf '  %-14s \033[1mv%s\033[0m  %b\n' "StatD Core" "$VERSION" "$statd_status_str"
        printf '  %-14s %s (%s) · Bash %s\n' "Platform" "$os_name" "$arch" "${BASH_VERSION%%(*}"
        printf '  %-14s %s (%dx%d)\n' "Terminal" "${TERM:-xterm}" "$term_w" "$term_h"
        printf '  %-14s %s\n' "Config" "$clean_conf"
        printf '\n'

        printf '  \033[1;34mPLUGINS\033[0m\n'
        printf '  \033[2m─────────────────────────────────────────────────────────────\033[0m\n'

        # Only list plugins that are actually installed
        local known=("theme|Color themes & custom palette manager" "api|Lightweight HTTP JSON & SSE metrics streaming API" "mcp|Model Context Protocol server for AI coding assistants")
        local installed_names=()
        local installed_descs=()
        local installed_vers=()
        local installed_statuses=()

        local item
        for item in "${known[@]}"; do
            IFS='|' read -r p_name p_desc <<< "$item"
            local p_bin
            p_bin=$(find_plugin_bin "$p_name" 2>/dev/null || true)
            if [ -n "$p_bin" ]; then
                local p_ver
                p_ver=$(get_plugin_version "$p_name")
                local p_remote
                p_remote=$(get_remote_plugin_version "$p_name")
                local p_status=""
                if [ -n "$p_remote" ] && [ "$p_remote" != "$p_ver" ]; then
                    p_status="\033[1;33m▲ update available: v${p_remote}\033[0m"
                elif [ -n "$p_remote" ]; then
                    p_status="\033[32m● up to date\033[0m"
                else
                    p_status="\033[2m● installed\033[0m"
                fi
                installed_names+=("$p_name")
                installed_descs+=("$p_desc")
                installed_vers+=("$p_ver")
                installed_statuses+=("$p_status")
            fi
        done

        local num_installed=${#installed_names[@]}
        if (( num_installed > 0 )); then
            local i
            for (( i=0; i<num_installed; i++ )); do
                printf '  \033[1;36m●\033[0m  \033[1;37m%-10s\033[0m \033[1mv%-6s\033[0m %b\n' "${installed_names[i]}" "${installed_vers[i]}" "${installed_statuses[i]}"
                printf '     \033[2m%s\033[0m\n\n' "${installed_descs[i]}"
            done
        else
            printf '  \033[2mNo plugins installed.\033[0m\n'
            printf '  \033[2m(Available: theme, api, mcp — install with: statd install <name>)\033[0m\n\n'
        fi

        if (( ! interactive )); then
            return 0
        fi

        printf '  \033[1;34mONE-CLICK ACTIONS\033[0m\n'
        printf '  \033[2m─────────────────────────────────────────────────────────────\033[0m\n'

        local prompt_keys=""
        if (( num_installed > 1 )); then
            printf '  \033[1;36m[u]\033[0m Update All (StatD + Plugins)   \033[1;36m[s]\033[0m Update StatD Core\n'
            printf '  \033[1;36m[p]\033[0m Update All Plugins             '
            prompt_keys="u/s/p"
            local i
            for (( i=0; i<num_installed; i++ )); do
                local key=$(( i + 1 ))
                printf '\033[1;36m[%d]\033[0m Update %-8s ' "$key" "${installed_names[i]}"
                prompt_keys="${prompt_keys}/${key}"
            done
            printf '\n  \033[1;36m[q]\033[0m Quit\n'
            prompt_keys="${prompt_keys}/q"
        elif (( num_installed == 1 )); then
            printf '  \033[1;36m[u]\033[0m Update All (StatD + Plugins)   \033[1;36m[s]\033[0m Update StatD Core\n'
            printf '  \033[1;36m[1]\033[0m Update %-24s\033[1;36m[q]\033[0m Quit\n' "${installed_names[0]}"
            prompt_keys="u/s/1/q"
        else
            printf '  \033[1;36m[u]\033[0m Update StatD Core              \033[1;36m[q]\033[0m Quit\n'
            prompt_keys="u/q"
        fi
        printf '  \033[2m─────────────────────────────────────────────────────────────\033[0m\n'
        printf '  \033[1;36mSelect action [%s]: \033[0m' "$prompt_keys"

        local action=""
        IFS= read -rsn1 action 2>/dev/null || true
        printf '\n\n'

        case "$action" in
            u|U)
                if (( num_installed > 0 )); then
                    statd_update "all"
                else
                    _statd_core_update
                fi
                printf '\n  \033[2mPress any key to return to About...\033[0m'
                read -rsn1 -t 15 _ 2>/dev/null || true
                ;;
            s|S)
                _statd_core_update
                printf '\n  \033[2mPress any key to return to About...\033[0m'
                read -rsn1 -t 15 _ 2>/dev/null || true
                ;;
            p|P)
                if (( num_installed > 0 )); then
                    statd_plugin_update "all"
                    printf '\n  \033[2mPress any key to return to About...\033[0m'
                    read -rsn1 -t 15 _ 2>/dev/null || true
                fi
                ;;
            [1-9])
                local target_idx=$(( action - 1 ))
                if (( target_idx >= 0 && target_idx < num_installed )); then
                    statd_plugin_update "${installed_names[target_idx]}"
                    printf '\n  \033[2mPress any key to return to About...\033[0m'
                    read -rsn1 -t 15 _ 2>/dev/null || true
                fi
                ;;
            q|Q|$'\e'|""|$'\r'|$'\n')
                break
                ;;
            *)
                break
                ;;
        esac
    done
    return 0
}

statd_network() {
    local opt="${1:-}"
    local iface=""
    if [ "$OS_TYPE" = "macos" ]; then
        iface=$(route -n get default 2>/dev/null | awk '/interface:/{print $2}')
        [ -z "$iface" ] && iface="en0"
    else
        [ -r /proc/net/route ] && iface=$(awk '$2 == "00000000" { print $1; exit }' /proc/net/route 2>/dev/null)
        [ -z "$iface" ] && iface=$(ip route show default 2>/dev/null | awk '/default via/{for(i=1;i<=NF;i++) if($i=="dev") print $(i+1); exit}')
        [ -z "$iface" ] && iface=$(ip route get 1.1.1.1 2>/dev/null | awk '{for(i=1;i<=NF;i++) if($i=="dev") print $(i+1); exit}')
        if [ -z "$iface" ]; then
            for _cand in wlan0 rmnet_data0 rmnet0 tun0 eth0 enp0s3; do
                if [ -d "/sys/class/net/$_cand" ]; then
                    iface="$_cand"
                    break
                fi
            done
        fi
        [ -z "$iface" ] && iface="wlan0"
    fi

    local loc_ip="" gw="" dns="" conns="0"
    if [ "$OS_TYPE" = "macos" ]; then
        loc_ip=$(ipconfig getifaddr "$iface" 2>/dev/null || ifconfig "$iface" 2>/dev/null | awk '/inet /{print $2}')
        gw=$(route -n get default 2>/dev/null | awk '/gateway:/{print $2}')
    else
        loc_ip=$(ip -4 addr show "$iface" 2>/dev/null | awk '/inet /{print $2}' | cut -d/ -f1)
        [ -z "$loc_ip" ] && loc_ip=$(getprop dhcp.wlan0.ipaddress 2>/dev/null)
        [ -z "$loc_ip" ] && loc_ip=$(hostname -I 2>/dev/null | awk '{print $1}')
        gw=$(getprop dhcp.wlan0.gateway 2>/dev/null)
        [ -z "$gw" ] && gw=$(ip route show default 2>/dev/null | awk '/default via/{print $3}')
        [ -z "$gw" ] && gw=$(ip route get 1.1.1.1 2>/dev/null | awk '{for(i=1;i<=NF;i++) if($i=="via") print $(i+1); exit}')
    fi
    dns=$(getprop net.dns1 2>/dev/null)
    [ -n "$dns" ] && [ -n "$(getprop net.dns2 2>/dev/null)" ] && dns="$dns, $(getprop net.dns2 2>/dev/null)"
    [ -z "$dns" ] && dns=$(awk '/nameserver/{print $2}' /etc/resolv.conf 2>/dev/null | paste -sd, -)
    conns=$(netstat -an 2>/dev/null | grep -c 'ESTABLISHED' 2>/dev/null || true)
    conns=$(echo "${conns:-0}" | tr -d '[:space:]')
    [[ "$conns" =~ ^[0-9]+$ ]] || conns=0

    local net_bytes
    net_bytes=$(get_network 2>/dev/null || true)
    local rx=0 tx=0
    if [ -n "$net_bytes" ]; then
        read -r rx tx _ <<< "$net_bytes"
    fi

    if [ "$opt" = "--json" ]; then
        cat <<EOF
{
  "network": {
    "interface": "${iface:-unknown}",
    "local_ip": "${loc_ip:-unknown}",
    "gateway": "${gw:-unknown}",
    "dns": "${dns:-unknown}",
    "connections": $conns,
    "rx_bytes": $rx,
    "tx_bytes": $tx
  }
}
EOF
        return 0
    fi

    local interactive=1
    if [ ! -t 0 ] || [ ! -t 1 ] || [ "$opt" = "--check" ] || [ "$opt" = "-1" ]; then
        interactive=0
    fi

    if (( interactive )); then
        printf '\033[?1049h\033[?25l'
        trap 'printf "\033[?25h\033[?1049l"; stty sane 2>/dev/null || true' EXIT INT TERM
        stty -echo icanon min 1 time 0 2>/dev/null || true
    fi

    local prev_rx=$rx prev_tx=$tx prev_t=$(date +%s%N)
    local rx_rate=0 tx_rate=0 peak_rate=1048576

    while true; do
        (( interactive )) && printf '\033[H\033[2J'

        # Refresh throughput
        net_bytes=$(get_network 2>/dev/null || true)
        if [ -n "$net_bytes" ]; then
            read -r cur_rx cur_tx _ <<< "$net_bytes"
            cur_t=$(date +%s%N)
            dt_ms=$(( (cur_t - prev_t) / 1000000 ))
            if (( dt_ms > 100 )); then
                (( cur_rx >= prev_rx )) && delta_rx=$(( cur_rx - prev_rx )) || delta_rx=0
                (( cur_tx >= prev_tx )) && delta_tx=$(( cur_tx - prev_tx )) || delta_tx=0
                rx_rate=$(( delta_rx * 1000 / dt_ms ))
                tx_rate=$(( delta_tx * 1000 / dt_ms ))
                tot_rate=$(( rx_rate + tx_rate ))
                (( tot_rate > peak_rate )) && peak_rate=$tot_rate
                prev_rx=$cur_rx; prev_tx=$cur_tx; prev_t=$cur_t
            fi
        fi

        local rx_pct=0 tx_pct=0
        if (( peak_rate > 0 )); then
            rx_pct=$(( rx_rate * 100 / peak_rate ))
            tx_pct=$(( tx_rate * 100 / peak_rate ))
            (( rx_pct > 100 )) && rx_pct=100
            (( tx_pct > 100 )) && tx_pct=100
        fi

        printf '\n'
        printf '  \033[1;37mstatd\033[0m \033[1;36mv%s\033[0m — network telemetry & diagnostics\n' "$VERSION"
        printf '  \033[2mhttps://github.com/Jaseunda/statd\033[0m\n\n'

        printf '  \033[1;34mINTERFACE & CONNECTION\033[0m\n'
        printf '  \033[2m─────────────────────────────────────────────────────────────\033[0m\n'
        printf '  %-14s \033[1m%s\033[0m\n' "Interface" "${iface:-none}"
        printf '  %-14s %s\n' "Local IP" "${loc_ip:---}"
        printf '  %-14s %s\n' "Gateway" "${gw:---}"
        printf '  %-14s %s\n' "DNS" "${dns:---}"
        printf '  %-14s %s active TCP\n' "Connections" "$conns"
        printf '\n'

        printf '  \033[1;34mLIVE THROUGHPUT & TRAFFIC\033[0m\n'
        printf '  \033[2m─────────────────────────────────────────────────────────────\033[0m\n'
        printf '  %-14s %-12s ' "Download (RX)" "▼ $(human "$rx_rate")/s"
        bar_gradient "$rx_pct" 24 "${BAR_MODE_NET:-cyan}"
        printf '  \033[2m(%3d%%)\033[0m\n' "$rx_pct"
        printf '  %-14s %-12s ' "Upload (TX)" "▲ $(human "$tx_rate")/s"
        bar_gradient "$tx_pct" 24 "${BAR_MODE_NET:-cyan}"
        printf '  \033[2m(%3d%%)\033[0m\n' "$tx_pct"
        printf '  %-14s %s down · %s up\n' "Session Total" "$(human "$cur_rx")" "$(human "$cur_tx")"
        printf '\n'

        if (( ! interactive )); then
            return 0
        fi

        printf '  \033[2mPress q to exit  ·  Refresh 1s\033[0m\n'

        local action=""
        IFS= read -rsn1 -t 1 action 2>/dev/null || true
        case "$action" in
            q|Q|$'\e')
                break
                ;;
        esac
    done
    return 0
}


# ------------------------------------------------------------
# Plugin system
# ------------------------------------------------------------
find_plugin_bin() {
    local name="$1"
    [ -z "$name" ] && return 1
    local cand
    for cand in \
        "$(pwd)/plugins/$name/statd-$name" \
        "$CONFIG_DIR/plugins/$name/statd-$name" \
        "$CONFIG_DIR/plugins/$name/$name" \
        "$STATD_LIB_DIR/plugins/$name/statd-$name" \
        "$STATD_LIB_DIR/plugins/$name/$name" \
        "$(dirname "$STATD_LIB_DIR")/plugins/$name/statd-$name" \
        "$(dirname "$STATD_LIB_DIR")/plugins/$name/$name"; do
        if [ -x "$cand" ]; then
            printf '%s' "$cand"
            return 0
        fi
    done
    return 1
}

statd_plugin_install() {
    local name="$1"
    if [ -z "$name" ]; then
        printf 'Usage: statd install <plugin>\n'
        printf 'Available plugins:\n'
        printf '  api      Lightweight HTTP JSON & SSE metrics streaming API\n'
        printf '  theme    Color themes & custom palette manager\n'
        printf '  mcp      Model Context Protocol server for AI coding assistants\n'
        return 1
    fi

    local target_dir="$STATD_LIB_DIR/plugins/$name"
    if [ ! -w "$STATD_LIB_DIR" ] 2>/dev/null; then
        target_dir="$CONFIG_DIR/plugins/$name"
    fi
    mkdir -p "$target_dir"

    printf '  \033[1mInstalling plugin:\033[0m %s\n' "$name"

    # Check local repository source or current working directory first
    local repo_plugin_dir="$(dirname "$STATD_LIB_DIR")/plugins/$name"
    local cwd_plugin_dir="$(pwd)/plugins/$name"
    if [ -d "$repo_plugin_dir" ] && [ -f "$repo_plugin_dir/statd-$name" ]; then
        cp -R "$repo_plugin_dir/"* "$target_dir/"
        chmod +x "$target_dir/statd-$name" 2>/dev/null || true
        printf '  \033[32m+\033[0m  Installed %s to %s\n' "$name" "$target_dir"
    elif [ -d "$cwd_plugin_dir" ] && [ -f "$cwd_plugin_dir/statd-$name" ]; then
        cp -R "$cwd_plugin_dir/"* "$target_dir/"
        chmod +x "$target_dir/statd-$name" 2>/dev/null || true
        printf '  \033[32m+\033[0m  Installed %s to %s\n' "$name" "$target_dir"
    else
        # Download from GitHub repository
        local base_url="https://raw.githubusercontent.com/Jaseunda/statd/main/plugins/$name"
        printf '  \033[32m+\033[0m  Downloading %s from GitHub ...\n' "$name"
        if curl -fsSL "$base_url/statd-$name" -o "$target_dir/statd-$name"; then
            chmod +x "$target_dir/statd-$name"
            curl -fsSL "$base_url/README.md" -o "$target_dir/README.md" 2>/dev/null || true
            printf '  \033[32m+\033[0m  Installed %s to %s\n' "$name" "$target_dir"
        else
            printf '  \033[31mx\033[0m  Failed to download plugin "%s"\n' "$name" >&2
            rm -rf "$target_dir"
            return 1
        fi
    fi

    printf '\n  \033[1;32mPlugin installed successfully!\033[0m\n\n'
    printf '  Run:    statd %s --help\n' "$name"
    printf '  Start:  statd %s\n\n' "$name"
    return 0
}

statd_plugin_remove() {
    local name="$1"
    if [ -z "$name" ]; then
        printf 'Usage: statd remove <plugin>\n'
        return 1
    fi
    local removed=0
    for d in "$STATD_LIB_DIR/plugins/$name" "$CONFIG_DIR/plugins/$name"; do
        if [ -d "$d" ]; then
            rm -rf "$d"
            printf '  \033[32m+\033[0m  Removed %s\n' "$d"
            removed=1
        fi
    done
    if (( removed )); then
        printf '  Plugin "%s" uninstalled.\n' "$name"
    else
        printf '  Plugin "%s" is not installed.\n' "$name"
    fi
    return 0
}

statd_plugin_list() {
    printf '\n  \033[1mStatD Plugins\033[0m\n\n'
    local known=("theme|Color themes & custom palette manager" "api|Lightweight HTTP JSON & SSE metrics streaming API" "mcp|Model Context Protocol server for AI coding assistants")
    local item
    for item in "${known[@]}"; do
        IFS='|' read -r p_name p_desc <<< "$item"
        local p_bin
        p_bin=$(find_plugin_bin "$p_name" 2>/dev/null || true)
        if [ -n "$p_bin" ]; then
            local p_ver
            p_ver=$(get_plugin_version "$p_name")
            printf '  \033[32m●\033[0m  \033[1m%-10s\033[0m \033[1mv%-6s\033[0m %s  \033[32m[installed]\033[0m\n' "$p_name" "$p_ver" "$p_desc"
            printf '              Run: statd %s (or statd %s --help)\n' "$p_name" "$p_name"
        else
            printf '  \033[2m○\033[0m  \033[1m%-10s\033[0m         %s  \033[2m[available]\033[0m\n' "$p_name" "$p_desc"
            printf '              Install: statd install %s\n' "$p_name"
        fi
    done
    printf '\n  Update plugins: statd update plugins  (or: statd plugins update)\n'
    printf '  System info:    statd about\n\n'
}

# ------------------------------------------------------------
# Command line options & Plugin Dispatch
# ------------------------------------------------------------
case "${1:-}" in
    install|remove|uninstall|update|-u|--update|--check-update|config|--config|plugins|plugin|about|-a|--about|-v|--version|version|-h|--help|help)
        # Built-in commands; bypass plugin dispatch
        ;;
    *)
        if [ -n "${1:-}" ]; then
            _plug_bin=$(find_plugin_bin "$1" 2>/dev/null || true)
            if [ -n "$_plug_bin" ] && [ -x "$_plug_bin" ]; then
                shift
                exec "$_plug_bin" "$@"
            fi
        fi
        ;;
esac

while [[ $# -gt 0 ]]; do
    case "$1" in
        about|-a|--about)
            shift
            statd_about "$@"
            exit $?
            ;;
        install)
            shift
            statd_plugin_install "$@"
            exit $?
            ;;
        remove|uninstall)
            shift
            statd_plugin_remove "$@"
            exit $?
            ;;
        plugins|plugin)
            shift
            case "${1:-}" in
                install)
                    shift
                    statd_plugin_install "$@"
                    exit $?
                    ;;
                update)
                    shift
                    statd_plugin_update "$@"
                    exit $?
                    ;;
                remove|uninstall)
                    shift
                    statd_plugin_remove "$@"
                    exit $?
                    ;;
                list)
                    statd_plugin_list
                    exit 0
                    ;;
                *)
                    statd_plugin_list
                    exit 0
                    ;;
            esac
            ;;
        api)
            printf '  \033[33m!\033[0m  Plugin "api" is not installed.\n'
            printf '     Install it with:  statd install api\n\n'
            exit 1
            ;;
        theme|themes)
            printf '  \033[33m!\033[0m  Plugin "theme" is not installed.\n'
            printf '     Install it with:  statd install theme\n\n'
            exit 1
            ;;
        mcp)
            printf '  \033[33m!\033[0m  Plugin "mcp" is not installed.\n'
            printf '     Install it with:  statd install mcp\n\n'
            exit 1
            ;;
        net|network)
            shift
            statd_network "$@"
            exit $?
            ;;
        config)
            shift
            statd_config "$@"
            exit $?
            ;;
        --config)
            shift
            statd_config "$@"
            exit $?
            ;;
        --no-ld|--hide-ld)
            SHOW_LD=0
            shift
            ;;
        --no-bat|--hide-bat)
            SHOW_BAT=0
            shift
            ;;
        --no-swp|--hide-swp)
            SHOW_SWP=0
            shift
            ;;
        --no-dsk|--hide-dsk)
            SHOW_DSK=0
            shift
            ;;
        --no-cpu)
            SHOW_CPU=0
            shift
            ;;
        --no-gpu|--hide-gpu)
            SHOW_GPU=0
            shift
            ;;
        -g|--gpu)
            SHOW_GPU=1
            shift
            ;;
        --no-ram)
            SHOW_RAM=0
            shift
            ;;
        --no-net|--hide-net)
            SHOW_NET=0
            shift
            ;;
        --net)
            SHOW_NET=1
            shift
            ;;
        -u|--update|update)
            shift
            statd_update "$@"
            exit $?
            ;;
        --check-update)
            statd_check_update
            exit $?
            ;;
        -v|--version|version)
            printf 'statd %s (bash %s)\n' "$VERSION" "$BASH_VERSION"
            exit 0
            ;;
        -h|--help|help)
            show_help
            exit 0
            ;;
        -f|--full|--fit)
            FULL_WIDTH=1
            shift
            ;;
        --no-full)
            FULL_WIDTH=0
            shift
            ;;
        -c|--cores)
            CORES_SHOWN=1
            shift
            ;;
        -i|--interval)
            if [[ -n "${2:-}" ]] && [[ "$2" =~ ^[0-9]+(\.[0-9]+)?$ ]]; then
                INTERVAL="$2"
                shift 2
            else
                printf 'statd: invalid or missing interval value\n' >&2
                exit 1
            fi
            ;;
        *)
            printf 'statd: unrecognized option: %s (see statd --help)\n' "$1" >&2
            exit 1
            ;;
    esac
done

# ------------------------------------------------------------
# Easter Egg: Benchmark & Stress Test Simulation (6 seconds, 60 FPS)
# Triggered by pressing "\"
# Ramps up CPU, GPU, RAM, Swap, Disks and Cores to 100% load
# ------------------------------------------------------------
trigger_dance_party() {
    local t_start
    t_start=$(date +%s)
    local frame=0

    printf '\033[?25l'

    while :; do
        local now
        now=$(date +%s)
        local elapsed_s=$(( now - t_start ))
        (( elapsed_s >= 6 )) && break

        frame=$(( frame + 1 ))

        local sec_left=$(( 6 - elapsed_s ))
        local tenth_left=$(( 9 - (frame % 10) ))
        (( tenth_left < 0 )) && tenth_left=0

        local head_text=""
        local timer_text=""
        local phase_color="\033[1;36m"

        if (( elapsed_s < 2 )); then
            head_text="BENCHMARK · MULTI-CORE LOAD RAMP-UP"
            timer_text="[RAMP 60FPS ${sec_left}.${tenth_left}s]"
            phase_color="\033[1;36m"
        elif (( elapsed_s < 5 )); then
            head_text="BENCHMARK · 100% COMPUTE SATURATION"
            timer_text="[STRESS 60FPS ${sec_left}.${tenth_left}s]"
            phase_color="\033[1;31m"
        else
            head_text="BENCHMARK · COOLDOWN & VERIFY"
            timer_text="[VERIFY 60FPS ${sec_left}.${tenth_left}s]"
            phase_color="\033[1;32m"
        fi

        local target_w=$TOTALW
        (( target_w < 12 )) && target_w=12
        local head_pad=$(( target_w - ${#head_text} - ${#timer_text} ))
        (( head_pad < 1 )) && head_pad=1

        local BENCH_FRAME=()
        BENCH_FRAME+=("$(printf '%b%s%*s\033[1;33m%s\033[0m' "$phase_color" "$head_text" "$head_pad" "" "$timer_text")")

        local r_idx=0
        for i in "${!LEFTP[@]}"; do
            local b_pct=10
            local b_mode="load"

            if (( elapsed_s < 2 )); then
                # Ramp up smoothly from baseline (15%) to 100%
                local ramp_ratio=$(( elapsed_s * 50 + (frame % 30) * 50 / 30 ))
                b_pct=$(( 15 + ramp_ratio * 85 / 100 ))
                (( b_pct > 100 )) && b_pct=100
                if (( b_pct < 60 )); then b_mode="cyan"
                elif (( b_pct < 85 )); then b_mode="amber"
                else b_mode="load"
                fi
            elif (( elapsed_s < 5 )); then
                # Peak saturation: 96% - 100% micro-jitter
                local jitter=$(( (frame * 7 + r_idx * 11) % 5 ))
                b_pct=$(( 96 + jitter ))
                (( b_pct > 100 )) && b_pct=100
                local party_modes=("amber" "purple" "load" "mag" "cyan")
                b_mode="${party_modes[$(( (frame / 8 + r_idx) % 5 ))]}"
            else
                # Cooldown from 100% down to 25%
                local cool_pct=$(( (6 - elapsed_s) * 75 ))
                b_pct=$(( 20 + cool_pct ))
                (( b_pct > 100 )) && b_pct=100
                b_mode="cyan"
            fi

            local orig_name="${LEFTP[$i]}"
            local metric_name="${orig_name%% *}"
            [ -z "$metric_name" ] && metric_name="MET"

            local b_left b_left_plain
            b_left=$(printf '\033[1m%-3s\033[0m \033[1;37m%3d%%\033[0m  ' "$metric_name" "$b_pct")
            b_left_plain=$(printf '%-3s %3d%%  ' "$metric_name" "$b_pct")

            local pad=$(( target_w - ${#b_left_plain} - ${#VALP[$i]} ))
            (( pad < 0 )) && pad=0

            BENCH_FRAME+=("$(printf '%s%*s%s' "$b_left" "$pad" "" "${VALC[$i]}")")
            BENCH_FRAME+=("$(bar_gradient "$b_pct" "$target_w" "$b_mode")")

            if (( i == 0 )) && (( ${#CORE_ROWS[@]} > 0 )); then
                case "$CORE_STYLE" in
                    dots)
                        local b_cline="${C_GREY}c ${C_RESET}"
                        for (( c=0; c<NCPU; c++ )); do
                            if (( elapsed_s >= 2 && elapsed_s < 5 )); then
                                b_cline+=$'\033[1;31m●'
                            else
                                local cp=$(( b_pct - (c * 3) ))
                                (( cp < 10 )) && cp=10
                                b_cline+="$(pct_color "$cp")●"
                            fi
                        done
                        BENCH_FRAME+=("${b_cline}${C_RESET}")
                        ;;
                    spark)
                        local SPK=(' ' '▂' '▃' '▄' '▅' '▆' '▇' '█')
                        local b_cline="${C_GREY}c ${C_RESET}"
                        for (( c=0; c<NCPU; c++ )); do
                            if (( elapsed_s >= 2 && elapsed_s < 5 )); then
                                b_cline+="\033[1;31m█"
                            else
                                local s_idx=$(( b_pct * 8 / 100 ))
                                (( s_idx > 7 )) && s_idx=7
                                b_cline+="$(pct_color "$b_pct")${SPK[$s_idx]}"
                            fi
                        done
                        BENCH_FRAME+=("${b_cline}${C_RESET}")
                        ;;
                    *)
                        for r in "${CORE_ROWS[@]}"; do BENCH_FRAME+=("$r"); done
                        ;;
                esac
            fi

            r_idx=$(( r_idx + 1 ))
        done

        # Render bench frame at top left
        printf '\033[H'
        for line in "${BENCH_FRAME[@]}"; do
            printf '\033[K%s\n' "$line"
        done

        sleep 0.016
    done

    # Flash completion score briefly
    local done_head="BENCHMARK PASSED · SCORE: 28,450"
    local done_timer="[PASSED 0 ERRORS]"
    local done_pad=$(( TOTALW - ${#done_head} - ${#done_timer} ))
    (( done_pad < 1 )) && done_pad=1
    printf '\033[H\033[K\033[1;32m%s%*s\033[1;32m%s\033[0m\n' "$done_head" "$done_pad" "" "$done_timer"
    sleep 0.4

    NEED_FULL_REDRAW=1
}

# ------------------------------------------------------------
# Lifecycle
# ------------------------------------------------------------
NEED_FULL_REDRAW=0
handle_winch() {
    NEED_FULL_REDRAW=1
}
trap handle_winch WINCH

cleanup() {
    local n=${PREV_NLINES:-${#FRAME[@]}}
    (( n < 1 )) && n=1
    printf '\033[%d;1H\033[J%s\033[?25h\n' $(( n + 1 )) "$C_RESET"
    exit 0
}
trap cleanup INT TERM

# If stdin is not a terminal (e.g. curl ... | bash), reconnect to /dev/tty if available
if [ ! -t 0 ] && [ -r /dev/tty ]; then
    exec < /dev/tty
fi

# Ensure UTF-8 locale if default is ASCII/POSIX (prevents broken multibyte characters)
if [[ "${LC_ALL:-${LC_CTYPE:-${LANG:-}}}" =~ ^(C|POSIX)$ ]] || [ -z "${LANG:-}" ]; then
    for _loc in C.UTF-8 en_US.UTF-8 UTF-8; do
        if locale -a 2>/dev/null | grep -qi "^${_loc}$"; then
            export LC_CTYPE="$_loc"
            break
        fi
    done
    export LC_CTYPE="${LC_CTYPE:-C.UTF-8}"
fi

PREV_TERM_LINES=0
PREV_TERM_COLS=0

printf '\033[?25l'
clear

# ============================================================
# Main loop
# ============================================================
while true; do

    # ---- Detect terminal geometry ----
    TERM_LINES=0
    TERM_COLS=0
    # 1. Query controlling tty via stty (ioctl TIOCGWINSZ — works accurately on macOS & Linux)
    if read -r _l _c < <({ stty size </dev/tty || stty size; } 2>/dev/null) && \
       [[ "$_c" =~ ^[0-9]+$ ]] && (( _c > 0 )); then
        TERM_LINES=$_l
        TERM_COLS=$_c
    fi
    # 2. Check bash COLUMNS/LINES (updated via checkwinsize)
    if (( TERM_COLS == 0 )) && [[ "$COLUMNS" =~ ^[0-9]+$ ]] && (( COLUMNS > 0 )); then
        TERM_COLS=$COLUMNS
        [[ "$LINES" =~ ^[0-9]+$ ]] && (( LINES > 0 )) && TERM_LINES=$LINES
    fi
    # 3. Fallback to tput if attached to a terminal
    if (( TERM_COLS == 0 )) && [ -t 1 ]; then
        _tc=$(tput cols 2>/dev/null || echo "")
        _tl=$(tput lines 2>/dev/null || echo "")
        [[ "$_tc" =~ ^[0-9]+$ ]] && (( _tc > 0 )) && TERM_COLS=$_tc
        [[ "$_tl" =~ ^[0-9]+$ ]] && (( _tl > 0 )) && TERM_LINES=$_tl
    fi
    # 4. Defaults
    [[ "$TERM_LINES" =~ ^[0-9]+$ ]] && (( TERM_LINES > 0 )) || TERM_LINES=24
    [[ "$TERM_COLS"  =~ ^[0-9]+$ ]] && (( TERM_COLS  > 0 )) || TERM_COLS=80

    if (( NEED_FULL_REDRAW || TERM_LINES != PREV_TERM_LINES || TERM_COLS != PREV_TERM_COLS )); then
        printf '\033[2J\033[H'
        PREV_LINES=()
        PREV_NLINES=0
        NEED_FULL_REDRAW=0
        PREV_TERM_LINES=$TERM_LINES
        PREV_TERM_COLS=$TERM_COLS
    fi

    # ---- Memory ----
    read -r MEM_TOTAL MEM_USED SWAP_TOTAL SWAP_USED <<< "$(get_memory)"
    MEM_TOTAL_B=$(( MEM_TOTAL * 1024 ))
    MEM_USED_B=$(( MEM_USED  * 1024 ))
    SWAP_TOTAL_B=$(( SWAP_TOTAL * 1024 ))
    SWAP_USED_B=$(( SWAP_USED  * 1024 ))
    (( MEM_TOTAL  > 0 )) && MEM_PCT=$(( MEM_USED  * 100 / MEM_TOTAL  )) || MEM_PCT=0
    (( SWAP_TOTAL > 0 )) && SWAP_PCT=$(( SWAP_USED * 100 / SWAP_TOTAL )) || SWAP_PCT=0

    # ---- Timing ----
    NOW=$(date +%s%N)
    DT_US=$(( (NOW - PREV_CPU_TIME) / 1000 ))

    # ---- CPU% ----
    CPU='--'
    read -r CPU_TOTAL CPU_IDLE <<< "$(get_cpu_raw)"
    if [[ "$CPU_TOTAL" == "PCT" ]]; then
        CPU="$CPU_IDLE"
        [[ "$CPU" =~ ^[0-9]+$ ]] || CPU=0
        (( CPU < 0 )) && CPU=0
        (( CPU > 100 )) && CPU=100
    elif [[ "$CPU_TOTAL" =~ ^[0-9]+$ ]]; then
        if (( PREV_CPU_TOTAL > 0 )); then
            C_DT=$(( CPU_TOTAL - PREV_CPU_TOTAL ))
            C_IDLE=$(( CPU_IDLE - PREV_CPU_IDLE ))
            if (( C_DT > 0 )); then
                CPU=$(( (C_DT - C_IDLE) * 100 / C_DT ))
                (( CPU <   0 )) && CPU=0
                (( CPU > 100 )) && CPU=100
            else
                CPU=0
            fi
        fi
        PREV_CPU_TOTAL=$CPU_TOTAL
        PREV_CPU_IDLE=$CPU_IDLE
    fi

    # Linux fallback: cpuidle residency when /proc/stat is unavailable.
    if [[ "$CPU" == '--' ]] && [ "$OS_TYPE" = "linux" ]; then
        IDLE_US=$(get_idle_us)
        if (( IDLE_US > 0 && PREV_IDLE_US > 0 && IDLE_US >= PREV_IDLE_US && DT_US > 0 )); then
            CAP_US=$(( DT_US * NCPU ))
            BUSY_US=$(( CAP_US - (IDLE_US - PREV_IDLE_US) ))
            (( BUSY_US < 0 )) && BUSY_US=0
            CPU=$(( BUSY_US * 100 / CAP_US ))
            (( CPU > 100 )) && CPU=100
        fi
        (( IDLE_US > 0 )) && PREV_IDLE_US=$IDLE_US
    fi

    # ---- Per-core % (Linux cpuidle residency; macOS shows placeholder) ----
    declare -a CUR_I=()
    if [ "$OS_TYPE" = "linux" ]; then
        while read -r c v; do
            [[ "$c" =~ ^[0-9]+$ ]] && CUR_I[$c]=$v
        done < <(get_core_idle)
    fi

    declare -a CORE_PCT=()
    for (( c=0; c<NCPU; c++ )); do
        pv=${PREV_CORE_I[$c]:-0}
        cv=${CUR_I[$c]:-0}
        cpc='--'
        if [ "$OS_TYPE" = "linux" ] && (( DT_US >= 200000 && pv > 0 && cv >= pv )); then
            didle=$(( cv - pv ))
            busy=$(( (DT_US - didle) * 100 / DT_US ))
            (( busy <   0 )) && busy=0
            (( busy > 100 )) && busy=100
            cpc=$busy
        fi
        CORE_PCT[$c]=$cpc
    done
    for c in "${!CUR_I[@]}"; do PREV_CORE_I[$c]=${CUR_I[$c]}; done
    PREV_CPU_TIME=$NOW

    FREQ=$(get_cpu_freq)
    TEMP=$(get_temp)

    # ---- LLM: llama-server tok/s via /metrics ----
    TPS_STR=''
    MOUT=$(get_llama_metrics || true)
    if [ -n "$MOUT" ]; then
        PTOK=$(printf '%s\n' "$MOUT" \
            | awk '$1 ~ /^llama_predicted_tokens_total/ {printf "%d", $NF; exit}' 2>/dev/null)
    else
        PTOK=''
    fi
    if [[ "$PTOK" =~ ^[0-9]+$ ]]; then
        if (( LLM_SEED && PTOK >= PREV_LLM_TOK )); then
            D_MS_L=$(( (NOW - PREV_LLM_T) / 1000000 ))
            (( D_MS_L < 200 )) && D_MS_L=200
            TPS10=$(( (PTOK - PREV_LLM_TOK) * 10000 / D_MS_L ))
            TPS_STR="$(printf '%d.%d' $(( TPS10 / 10 )) $(( TPS10 % 10 )))"
        fi
        PREV_LLM_TOK=$PTOK
        PREV_LLM_T=$NOW
        LLM_SEED=1
    else
        LLM_SEED=0
    fi

    # ---- LLM: fallback process CPU% + RSS ----
    LCPU_STR=''
    RSS_STR=''
    if ! llama_pid_alive "$LPID"; then
        LPID=""
        LLM_CPU_SEED=0
        LLM_TICKS_PREV=0
    fi
    if [ -z "$LPID" ]; then
        PID_SCAN_COUNT=$(( PID_SCAN_COUNT + 1 ))
        if (( PID_INIT == 0 || PID_SCAN_COUNT >= PID_SCAN_EVERY )); then
            LPID=$(find_llama_pid)
            PID_SCAN_COUNT=0
            PID_INIT=1
        fi
    fi

    if [ -n "$LPID" ]; then
        read -r L_TICKS L_RSS _junk <<< "$(get_llama_proc_stats "$LPID" 2>/dev/null)"
        if [[ "$L_TICKS" =~ ^[0-9]+$ ]]; then
            if [ "$OS_TYPE" = "macos" ]; then
                # macOS: get_llama_proc_stats returns instantaneous pcpu + rss_kB
                LC=$L_TICKS
                [[ "$LC" =~ ^[0-9]+$ ]] && (( LC > 999 )) && LC=999
                LCPU_STR="$LC"
            else
                if (( LLM_CPU_SEED )); then
                    D_TICKS=$(( L_TICKS - LLM_TICKS_PREV ))
                    D_MS=$(( (NOW - PREV_LLM_T2) / 1000000 ))
                    if (( D_MS >= 200 && D_TICKS >= 0 )); then
                        LC=$(( D_TICKS * 100000 / (CLK_TCK * D_MS) ))
                        (( LC > 999 )) && LC=999
                        LCPU_STR="$LC"
                    fi
                fi
            fi
            LLM_TICKS_PREV=$L_TICKS
            PREV_LLM_T2=$NOW
            LLM_CPU_SEED=1
        fi
        if [[ "$L_RSS" =~ ^[0-9]+$ ]] && (( L_RSS > 0 )); then
            if [ "$OS_TYPE" = "macos" ]; then
                RSS_STR=$(human $(( L_RSS * 1024 )))     # ps rss is in kB on macOS
            else
                RSS_STR=$(human $(( L_RSS * PAGE_SIZE ))) # /proc rss is in pages on Linux
            fi
        fi
    fi

    # ---- Load average ----
    L1='--'; L5='--'; L15='--'; NPROC=''; LD_PCT=''
    read -r L1 L5 L15 RUNTOT <<< "$(get_loadavg)"
    if [[ "$L1" =~ ^[0-9]+\.[0-9][0-9]$ \
       && "$L5" =~ ^[0-9]+\.[0-9][0-9]$ \
       && "$L15" =~ ^[0-9]+\.[0-9][0-9]$ ]]; then
        L100=$(( 10#${L1/./} ))
        LD_PCT=$(( L100 / NCPU ))
        (( LD_PCT > 100 )) && LD_PCT=100
        NPROC="${RUNTOT##*/}"
    else
        L1='--'; L5='--'; L15='--'
    fi

    # ---- Slow tier: battery, disk, uptime (refreshed every SLOW_EVERY s) ----
    SLOW_COUNT=$(( SLOW_COUNT + 1 ))
    if (( SLOW_INIT == 0 || SLOW_COUNT >= SLOW_EVERY )); then
        read -r DISK_TOTAL DISK_USED <<< "$(get_disk)"
        (( DISK_TOTAL > 0 )) \
            && DISK_PCT=$(( DISK_USED * 100 / DISK_TOTAL )) \
            || DISK_PCT=0
        read -r BATT_PCT BATT_STATUS <<< "$(get_battery)"
        UP=$(get_uptime)
        SLOW_COUNT=0
        SLOW_INIT=1
    fi

    # ---- Temperature color ----
    if [[ "$TEMP" =~ ^[0-9]+$ ]]; then
        if   (( TEMP < 40 )); then TEMP_COLOR=$C_GREEN
        elif (( TEMP < 55 )); then TEMP_COLOR=$C_YELLOW
        else                       TEMP_COLOR=$C_RED
        fi
        TEMP_STR="${TEMP}C"
    else
        TEMP_COLOR="$C_GREY"
        TEMP_STR="--"
    fi

    # ---- GPU ----
    GPU_PCT='' GPU_MEM_USED=0 GPU_MEM_TOTAL=0 GPU_TEMP='--' GPU_MODEL=''
    if (( SHOW_GPU )); then
        read -r GPU_PCT GPU_MEM_USED GPU_MEM_TOTAL GPU_TEMP GPU_MODEL <<< "$(get_gpu)"
        [[ "$GPU_PCT" =~ ^[0-9]+$ ]] || GPU_PCT=''
        [[ "$GPU_MEM_USED" =~ ^[0-9]+$ ]] || GPU_MEM_USED=0
        [[ "$GPU_MEM_TOTAL" =~ ^[0-9]+$ ]] || GPU_MEM_TOTAL=0
    fi

    # ---- Network ----
    if (( SHOW_NET )); then
        _net_data=$(get_network 2>/dev/null || true)
        if [ -n "$_net_data" ]; then
            read -r _cur_rx _cur_tx _cur_iface <<< "$_net_data"
            _cur_t=$(date +%s%N)
            if (( PREV_NET_TIME > 0 && _cur_t > PREV_NET_TIME )); then
                _dt_ms=$(( (_cur_t - PREV_NET_TIME) / 1000000 ))
                if (( _dt_ms > 100 )); then
                    (( _cur_rx >= PREV_NET_RX )) && _delta_rx=$(( _cur_rx - PREV_NET_RX )) || _delta_rx=0
                    (( _cur_tx >= PREV_NET_TX )) && _delta_tx=$(( _cur_tx - PREV_NET_TX )) || _delta_tx=0
                    NET_RX_RATE=$(( _delta_rx * 1000 / _dt_ms ))
                    NET_TX_RATE=$(( _delta_tx * 1000 / _dt_ms ))
                    _total_rate=$(( NET_RX_RATE + NET_TX_RATE ))
                    (( _total_rate > NET_PEAK_BPS )) && NET_PEAK_BPS=$_total_rate
                    if (( NET_PEAK_BPS > 0 )); then
                        NET_PCT=$(( _total_rate * 100 / NET_PEAK_BPS ))
                        (( NET_PCT > 100 )) && NET_PCT=100
                    else
                        NET_PCT=0
                    fi
                    NET_IFACE="$_cur_iface"
                fi
            else
                NET_PCT=0
                NET_RX_RATE=0
                NET_TX_RATE=0
                NET_IFACE="$_cur_iface"
            fi
            PREV_NET_RX=$_cur_rx
            PREV_NET_TX=$_cur_tx
            PREV_NET_TIME=$_cur_t
        else
            NET_PCT=""
        fi
    fi

    # ============================================================
    # Build frame
    # ============================================================
    declare -a LEFTP=() LEFTC=() VALP=() VALC=() ROWPCT=() ROWMODE=()

    # Pre-calculate target width and space available for right-side metrics
    if (( FULL_WIDTH )) || (( TERM_COLS <= 45 )); then
        TARGET_W=$TERM_COLS
    else
        TARGET_W=36
    fi
    (( TARGET_W > TERM_COLS )) && TARGET_W=$TERM_COLS
    (( TARGET_W < 12 )) && TARGET_W=12
    AVAIL_R=$(( TARGET_W - 10 ))
    (( AVAIL_R < 0 )) && AVAIL_R=0

    if (( SHOW_CPU )); then
        row_start
        seg "CPU" "$C_BOLD"
        seg " $(printf '%3s' "$CPU")" "$(pct_color "$CPU")"
        seg "%  " ""
        LEFTP+=("$ROW_PLAIN"); LEFTC+=("$ROW_COLORED")
        row_start
        if [ "$FREQ" != "--" ] && [ -n "$FREQ" ] && [ "$TEMP_STR" != "--" ] && [ -n "$TEMP_STR" ]; then
            if (( ${#FREQ} + 2 + ${#TEMP_STR} <= AVAIL_R )); then
                seg "$FREQ" "$C_BLUE"
                seg "  " ""
                seg "$TEMP_STR" "$TEMP_COLOR"
            elif (( ${#TEMP_STR} <= AVAIL_R )); then
                seg "$TEMP_STR" "$TEMP_COLOR"
            elif (( ${#FREQ} <= AVAIL_R )); then
                seg "$FREQ" "$C_BLUE"
            fi
        elif [ "$TEMP_STR" != "--" ] && [ -n "$TEMP_STR" ]; then
            (( ${#TEMP_STR} <= AVAIL_R )) && seg "$TEMP_STR" "$TEMP_COLOR"
        elif [ "$FREQ" != "--" ] && [ -n "$FREQ" ]; then
            (( ${#FREQ} <= AVAIL_R )) && seg "$FREQ" "$C_BLUE"
        fi
        VALP+=("$ROW_PLAIN"); VALC+=("$ROW_COLORED"); ROWPCT+=("$CPU"); ROWMODE+=("${BAR_MODE_CPU:-load}")
    fi

    if (( SHOW_GPU )) && [ -n "$GPU_PCT" ]; then
        row_start
        seg "GPU" "$C_BOLD"
        seg " $(printf '%3d' "$GPU_PCT")" "$(pct_color "$GPU_PCT")"
        seg "%  " ""
        LEFTP+=("$ROW_PLAIN"); LEFTC+=("$ROW_COLORED")
        row_start
        _gpu_mem=""
        if (( GPU_MEM_USED > 0 && GPU_MEM_TOTAL > 0 )); then
            _gpu_mem="$(human "$GPU_MEM_USED")/$(human "$GPU_MEM_TOTAL")"
        elif (( GPU_MEM_USED > 0 )); then
            _gpu_mem="$(human "$GPU_MEM_USED")"
        fi

        _gpu_temp=""
        if [[ "$GPU_TEMP" =~ ^[0-9]+$ ]]; then
            _gpu_temp="${GPU_TEMP}C"
        fi

        if [ -n "$_gpu_mem" ] && [ -n "$_gpu_temp" ]; then
            if (( ${#_gpu_mem} + 2 + ${#_gpu_temp} <= AVAIL_R )); then
                seg "$_gpu_mem" "$C_DIM"
                seg "  " ""
                seg "$_gpu_temp" "$(temp_color "$GPU_TEMP")"
            elif (( ${#_gpu_mem} <= AVAIL_R )); then
                seg "$_gpu_mem" "$C_DIM"
            elif (( ${#_gpu_temp} <= AVAIL_R )); then
                seg "$_gpu_temp" "$(temp_color "$GPU_TEMP")"
            fi
        elif [ -n "$_gpu_mem" ]; then
            if (( ${#_gpu_mem} <= AVAIL_R )); then
                seg "$_gpu_mem" "$C_DIM"
            fi
        elif [ -n "$_gpu_temp" ]; then
            if (( ${#_gpu_temp} <= AVAIL_R )); then
                seg "$_gpu_temp" "$(temp_color "$GPU_TEMP")"
            fi
        elif [ -n "$GPU_MODEL" ] && [ "$GPU_MODEL" != "--" ]; then
            _short_model="$GPU_MODEL"
            (( ${#_short_model} > AVAIL_R )) && _short_model="${_short_model:0:$AVAIL_R}"
            seg "$_short_model" "$C_DIM"
        fi
        VALP+=("$ROW_PLAIN"); VALC+=("$ROW_COLORED"); ROWPCT+=("$GPU_PCT"); ROWMODE+=("${BAR_MODE_GPU:-cyan}")
    fi

    if (( SHOW_RAM )); then
        row_start
        seg "RAM" "$C_BOLD"
        seg " $(printf '%3d' "$MEM_PCT")" "$(pct_color "$MEM_PCT")"
        seg "%  " ""
        LEFTP+=("$ROW_PLAIN"); LEFTC+=("$ROW_COLORED")
        row_start
        _ram_full="$(human "$MEM_USED_B")/$(human "$MEM_TOTAL_B")"
        _ram_used="$(human "$MEM_USED_B")"
        if (( ${#_ram_full} <= AVAIL_R )); then
            seg "$_ram_full" "$C_DIM"
        elif (( ${#_ram_used} <= AVAIL_R )); then
            seg "$_ram_used" "$C_DIM"
        fi
        VALP+=("$ROW_PLAIN"); VALC+=("$ROW_COLORED"); ROWPCT+=("$MEM_PCT"); ROWMODE+=("${BAR_MODE_RAM:-load}")
    fi

    if (( SHOW_SWP )); then
        row_start
        seg "SWP" "$C_BOLD"
        seg " $(printf '%3d' "$SWAP_PCT")" "$C_MAG"
        seg "%  " ""
        LEFTP+=("$ROW_PLAIN"); LEFTC+=("$ROW_COLORED")
        row_start
        _swp_full="$(human "$SWAP_USED_B")/$(human "$SWAP_TOTAL_B")"
        _swp_used="$(human "$SWAP_USED_B")"
        if (( ${#_swp_full} <= AVAIL_R )); then
            seg "$_swp_full" "$C_MAG"
        elif (( ${#_swp_used} <= AVAIL_R )); then
            seg "$_swp_used" "$C_MAG"
        fi
        VALP+=("$ROW_PLAIN"); VALC+=("$ROW_COLORED"); ROWPCT+=("$SWAP_PCT"); ROWMODE+=("${BAR_MODE_SWP:-mag}")
    fi

    if (( SHOW_DSK )); then
        row_start
        seg "DSK" "$C_BOLD"
        seg " $(printf '%3d' "$DISK_PCT")" "$(pct_color "$DISK_PCT")"
        seg "%  " ""
        LEFTP+=("$ROW_PLAIN"); LEFTC+=("$ROW_COLORED")
        row_start
        _dsk_full="$(human "$DISK_USED")/$(human "$DISK_TOTAL")"
        _dsk_used="$(human "$DISK_USED")"
        if (( ${#_dsk_full} <= AVAIL_R )); then
            seg "$_dsk_full" "$C_DIM"
        elif (( ${#_dsk_used} <= AVAIL_R )); then
            seg "$_dsk_used" "$C_DIM"
        fi
        VALP+=("$ROW_PLAIN"); VALC+=("$ROW_COLORED"); ROWPCT+=("$DISK_PCT"); ROWMODE+=("${BAR_MODE_DSK:-load}")
    fi

    if (( SHOW_LD )) && [[ "$LD_PCT" =~ ^[0-9]+$ ]]; then
        row_start
        seg "LD " "$C_BOLD"
        seg " $(printf '%3d' "$LD_PCT")" "$(pct_color "$LD_PCT")"
        seg "%  " ""
        LEFTP+=("$ROW_PLAIN"); LEFTC+=("$ROW_COLORED")
        row_start
        _ld_all="$L1 $L5 $L15  ${NPROC}p"
        _ld_three="$L1 $L5 $L15"
        _ld_two="$L1 $L5"
        _ld_one="$L1"
        if [ -n "$NPROC" ] && (( ${#_ld_all} <= AVAIL_R )); then
            seg "$_ld_all" "$C_DIM"
        elif (( ${#_ld_three} <= AVAIL_R )); then
            seg "$_ld_three" "$C_DIM"
        elif (( ${#_ld_two} <= AVAIL_R )); then
            seg "$_ld_two" "$C_DIM"
        elif (( ${#_ld_one} <= AVAIL_R )); then
            seg "$_ld_one" "$C_DIM"
        fi
        VALP+=("$ROW_PLAIN"); VALC+=("$ROW_COLORED"); ROWPCT+=("$LD_PCT"); ROWMODE+=("${BAR_MODE_LD:-load}")
    fi

    if (( SHOW_NET )) && [[ "$NET_PCT" =~ ^[0-9]+$ ]]; then
        row_start
        seg "NET" "$C_BOLD"
        seg " $(printf '%3d' "$NET_PCT")" "$(pct_color "$NET_PCT")"
        seg "%  " ""
        LEFTP+=("$ROW_PLAIN"); LEFTC+=("$ROW_COLORED")
        row_start
        _rx_str="▼ $(human "$NET_RX_RATE")/s"
        _tx_str="▲ $(human "$NET_TX_RATE")/s"
        _net_full="$_rx_str  $_tx_str  $NET_IFACE"
        _net_rates="$_rx_str  $_tx_str"
        _net_rx="▼ $(human "$NET_RX_RATE")/s"
        if [ -n "$NET_IFACE" ] && (( ${#_net_full} <= AVAIL_R )); then
            seg "$_net_full" "$C_DIM"
        elif (( ${#_net_rates} <= AVAIL_R )); then
            seg "$_net_rates" "$C_DIM"
        elif (( ${#_net_rx} <= AVAIL_R )); then
            seg "$_net_rx" "$C_DIM"
        fi
        VALP+=("$ROW_PLAIN"); VALC+=("$ROW_COLORED"); ROWPCT+=("$NET_PCT"); ROWMODE+=("${BAR_MODE_NET:-cyan}")
    fi

    VALMAX=0
    LEFTW=0
    for v in "${VALP[@]}"; do (( ${#v} > VALMAX )) && VALMAX=${#v}; done
    for l in "${LEFTP[@]}"; do (( ${#l} > LEFTW )) && LEFTW=${#l}; done
    MIN_W=$(( LEFTW + VALMAX ))

    # Full width: automatically fill terminal on mini displays (<= 45 cols) or when FULL_WIDTH=1
    if (( FULL_WIDTH )) || (( TERM_COLS <= 45 )); then
        TOTALW=$TERM_COLS
    else
        TOTALW=$MIN_W
        (( TOTALW < BAR_WIDTH )) && TOTALW=$BAR_WIDTH
    fi

    # Safety: clamp to TERM_COLS
    if (( TERM_COLS > 10 )) && (( TOTALW > TERM_COLS )); then
        TOTALW=$TERM_COLS
    fi
    (( TOTALW < 12 )) && TOTALW=12

    # ---- Per-core panel ----
    CORE_ROWS=()
    if (( CORES_SHOWN )); then
        MAX_PER_ROW=$(( TOTALW - 2 ))
        (( MAX_PER_ROW < 8 )) && MAX_PER_ROW=8

        case "$CORE_STYLE" in
            dots)
                line="${C_GREY}c ${C_RESET}"
                row_cnt=0
                for (( c=0; c<NCPU; c++ )); do
                    if (( row_cnt >= MAX_PER_ROW )); then
                        CORE_ROWS+=("${line}${C_RESET}")
                        line="  "
                        row_cnt=0
                    fi
                    p="${CORE_PCT[$c]:---}"
                    if [[ "$p" =~ ^[0-9]+$ ]]; then
                        line+="$(pct_color "$p")●"
                    else
                        line+="${C_GREY}·"
                    fi
                    (( row_cnt++ ))
                done
                CORE_ROWS+=("${line}${C_RESET}")
                ;;
            spark)
                SPK=(' ' '▂' '▃' '▄' '▅' '▆' '▇' '█')
                line="${C_GREY}c ${C_RESET}"
                row_cnt=0
                for (( c=0; c<NCPU; c++ )); do
                    if (( row_cnt >= MAX_PER_ROW )); then
                        CORE_ROWS+=("${line}${C_RESET}")
                        line="  "
                        row_cnt=0
                    fi
                    p="${CORE_PCT[$c]:---}"
                    if [[ "$p" =~ ^[0-9]+$ ]]; then
                        idx=$(( p * 8 / 100 ))
                        (( idx > 7 )) && idx=7
                        char="${SPK[$idx]}"
                        line+="$(pct_color "$p")${char}"
                    else
                        line+="${C_GREY}·"
                    fi
                    (( row_cnt++ ))
                done
                CORE_ROWS+=("${line}${C_RESET}")
                ;;
            seg)
                WT=$(( TOTALW - 2 ))
                (( WT < NCPU )) && WT=$NCPU
                BASE=$(( WT / NCPU ))
                REM=$(( WT % NCPU ))
                line="${C_GREY}└ ${C_RESET}"
                for (( c=0; c<NCPU; c++ )); do
                    w=$BASE
                    (( c < REM )) && w=$(( w + 1 ))
                    line+="$(bar_gradient "${CORE_PCT[$c]}" "$w" load)"
                done
                CORE_ROWS+=("$line")
                ;;
            mini)
                HALF=$(( (NCPU + 1) / 2 ))
                for (( r=0; r<HALF; r++ )); do
                    lc=$r
                    rc=$(( r + HALF ))
                    line="$(core_cell "$lc" "${CORE_PCT[$lc]:---}")"
                    if (( rc < NCPU )); then
                        line+="   $(core_cell "$rc" "${CORE_PCT[$rc]:---}")"
                    fi
                    CORE_ROWS+=("$line")
                done
                ;;
        esac
    fi

    # ---- Header: clock + uptime ----
    CLOCK="$(date +%H:%M:%S)"
    UPTXT="up $UP"
    pad=$(( TOTALW - ${#CLOCK} - ${#UPTXT} ))
    if (( pad < 1 )); then
        UPTXT="${UPTXT// /}"
        pad=$(( TOTALW - ${#CLOCK} - ${#UPTXT} ))
    fi
    if (( pad < 1 )); then
        UPTXT="$UP"
        pad=$(( TOTALW - ${#CLOCK} - ${#UPTXT} ))
    fi
    if (( pad < 1 )); then
        UPTXT=""
        pad=0
    fi

    FRAME=()
    if [ -n "$UPTXT" ]; then
        FRAME+=("$(printf '%s%s%*s%s%s' "$C_DIM" "$CLOCK" "$pad" "" "$UPTXT" "$C_RESET")")
    else
        FRAME+=("$(printf '%s%s%s' "$C_DIM" "$CLOCK" "$C_RESET")")
    fi

    for i in "${!LEFTP[@]}"; do
        pad=$(( TOTALW - ${#LEFTP[$i]} - ${#VALP[$i]} ))
        (( pad < 0 )) && pad=0
        FRAME+=("$(printf '%s%*s%s' "${LEFTC[$i]}" "$pad" "" "${VALC[$i]}")")
        FRAME+=("$(bar_gradient "${ROWPCT[$i]}" "$TOTALW" "${ROWMODE[$i]}")")
        if (( i == 0 )) && (( ${#CORE_ROWS[@]} > 0 )); then
            for r in "${CORE_ROWS[@]}"; do FRAME+=("$r"); done
        fi
    done

    # ---- LLM row ----
    if (( SHOW_LLM )) && { [ -n "$TPS_STR" ] || [ -n "$LCPU_STR" ] || [ -n "$RSS_STR" ]; }; then
        row_start
        seg "LLM" "$C_BOLD"
        [ -n "$TPS_STR" ]  && seg " ${TPS_STR} t/s" "$C_CYAN"
        _llm_left="$ROW_COLORED"
        _llm_left_plain="$ROW_PLAIN"

        row_start
        _llm_avail=$(( TOTALW - ${#_llm_left_plain} ))
        (( _llm_avail < 0 )) && _llm_avail=0
        if [ -n "$LCPU_STR" ] && [ -n "$RSS_STR" ]; then
            if (( ${#LCPU_STR} + 3 + ${#RSS_STR} <= _llm_avail )); then
                seg "${LCPU_STR}%" "$(pct_color "$LCPU_STR")"
                seg "  " ""
                seg "${RSS_STR}" "$C_DIM"
            elif (( ${#LCPU_STR} + 1 <= _llm_avail )); then
                seg "${LCPU_STR}%" "$(pct_color "$LCPU_STR")"
            elif (( ${#RSS_STR} <= _llm_avail )); then
                seg "${RSS_STR}" "$C_DIM"
            fi
        elif [ -n "$LCPU_STR" ]; then
            (( ${#LCPU_STR} + 1 <= _llm_avail )) && seg "${LCPU_STR}%" "$(pct_color "$LCPU_STR")"
        elif [ -n "$RSS_STR" ]; then
            (( ${#RSS_STR} <= _llm_avail )) && seg "${RSS_STR}" "$C_DIM"
        fi
        _llm_val="$ROW_COLORED"
        _llm_val_plain="$ROW_PLAIN"

        _llm_pad=$(( TOTALW - ${#_llm_left_plain} - ${#_llm_val_plain} ))
        (( _llm_pad < 0 )) && _llm_pad=0
        FRAME+=("$(printf '%s%*s%s' "$_llm_left" "$_llm_pad" "" "$_llm_val")")
    fi

    # ---- Battery row ----
    if (( SHOW_BAT )) && [ -n "$BATT_PCT" ]; then
        row_start
        seg "BAT" "$C_BOLD"
        seg " $(printf '%3d' "$BATT_PCT")" "$(pct_color $(( 100 - BATT_PCT )))"
        seg "%  " ""
        _b_left="$ROW_COLORED"
        _b_left_plain="$ROW_PLAIN"

        row_start
        _bat_avail=$(( TOTALW - ${#_b_left_plain} ))
        (( _bat_avail < 0 )) && _bat_avail=0
        _b_text="$BATT_STATUS"
        if (( ${#_b_text} > _bat_avail )); then
            case "$_b_text" in
                *discharg*) _b_text="dischg" ;;
                *charg*)    _b_text="chrg" ;;
                *attach*)   _b_text="ac" ;;
            esac
        fi
        (( ${#_b_text} > _bat_avail )) && _b_text="${_b_text:0:$_bat_avail}"
        [ -n "$_b_text" ] && seg "$_b_text" "$C_DIM"
        _b_val="$ROW_COLORED"
        _b_val_plain="$ROW_PLAIN"

        _b_pad=$(( TOTALW - ${#_b_left_plain} - ${#_b_val_plain} ))
        (( _b_pad < 0 )) && _b_pad=0
        FRAME+=("$(printf '%s%*s%s' "$_b_left" "$_b_pad" "" "$_b_val")")
    fi

    # ============================================================
    # Prevent height overflow: never exceed available terminal rows
    # ============================================================
    MAX_LINES=$(( TERM_LINES > 1 ? TERM_LINES - 1 : 1 ))
    if (( ${#FRAME[@]} > MAX_LINES )); then
        FRAME=("${FRAME[@]:0:$MAX_LINES}")
    fi

    # ============================================================
    # Dirty-line diff render — only rewrite lines that changed
    # ============================================================
    OUT=''
    NEW_N=${#FRAME[@]}
    for (( i=0; i<NEW_N; i++ )); do
        if (( i < PREV_NLINES )) && [[ "${FRAME[i]}" == "${PREV_LINES[i]}" ]]; then
            continue
        fi
        printf -v CHUNK '\033[%d;1H\033[K%s' $(( i + 1 )) "${FRAME[i]}"
        OUT+=$CHUNK
    done
    if (( NEW_N < PREV_NLINES )); then
        printf -v CHUNK '\033[%d;1H\033[J' $(( NEW_N + 1 ))
        OUT+=$CHUNK
    fi
    OUT+=$'\033[1;1H'
    [[ -n "$OUT" ]] && printf '%s' "$OUT"
    PREV_LINES=("${FRAME[@]}")
    PREV_NLINES=$NEW_N

    # ============================================================
    # Wait INTERVAL seconds; wake early on keypress
    # ============================================================
    T_END=$(( $(date +%s%N) + INTERVAL * 1000000000 ))
    while :; do
        CUR_T=$(date +%s%N)
        (( CUR_T >= T_END )) && break
        key=''
        if [ -t 0 ]; then
            if [ -n "$READ_TIMEOUT" ]; then
                IFS= read -rsn1 -t "$READ_TIMEOUT" key 2>/dev/null || true
            else
                IFS= read -rsn1 -t 1 key 2>/dev/null || true
            fi
        else
            sleep 0.1
        fi
        case "$key" in
            c|C) CORES_SHOWN=$(( 1 - CORES_SHOWN )); break ;;
            g|G) SHOW_GPU=$(( 1 - SHOW_GPU )); break ;;
            f|F|w|W) FULL_WIDTH=$(( 1 - FULL_WIDTH )); NEED_FULL_REDRAW=1; break ;;
            l|L) SHOW_LD=$(( 1 - SHOW_LD )); break ;;
            b|B) SHOW_BAT=$(( 1 - SHOW_BAT )); break ;;
            s|S) SHOW_SWP=$(( 1 - SHOW_SWP )); break ;;
            d|D) SHOW_DSK=$(( 1 - SHOW_DSK )); break ;;
            n|N) SHOW_NET=$(( 1 - SHOW_NET )); break ;;
            "\\") trigger_dance_party; NEED_FULL_REDRAW=1; break ;;
            q|Q) cleanup ;;
        esac
    done

done
