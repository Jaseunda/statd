# pct_color <integer-percent>
# Prints the ANSI escape for green/yellow/red based on load level.
pct_color() {
    local pct=${1:-0}
    if [[ ! "$pct" =~ ^[0-9]+$ ]]; then
        printf '%s' "$C_GREY"
        return
    fi
    if   (( pct < 60 )); then printf '%s' "$C_GREEN"
    elif (( pct < 85 )); then printf '%s' "$C_YELLOW"
    else                       printf '%s' "$C_RED"
    fi
}
