    printf '  %b%-22s%b %s\n' "$C_CYAN" "-c, --cores"          "$C_DIM" "Start with per-core CPU sparklines visible"
    printf '  %b%-22s%b %s\n' "$C_CYAN" "-i, --interval <sec>" "$C_DIM" "Refresh interval in seconds (default: 1)"
