        printf '%b  │   %b%-53s%b   │\033[0m\n' "$c_border" "$c_title" "$title" "$c_border"
        printf '%b  └─────────────────────────────────────────────────────────────┘\033[0m\n\n' "$c_border"
        printf '%b  %s\033[0m\n\n' "$c_dance1" "$d_top"
        printf '%b   %s\033[0m\n\n' "$c_eq" "$eq"
        printf '%b  %s\033[0m\n\n' "$c_dance2" "$d_bot"

        printf '  %bGroove Timer:\033[0m %b[' "$c_title" "$c_bar"
        local j
        for (( j=0; j<filled_w; j++ )); do printf '█'; done
        printf '\033[90m'
        for (( j=0; j<empty_w; j++ )); do printf '░'; done
        printf '%b]\033[0m  \033[1m%d.%ds\033[0m \033[2m(vibing...)\033[0m\n' "$c_bar" "$sec" "$tenth"

        sleep 0.15
    done

    printf '\033[?25h\033[H\033[2J'
}

# ------------------------------------------------------------
# Interactive TUI Theme Selector
# ------------------------------------------------------------
interactive_picker() {
    # If not connected to a terminal, fall back to status
    if [ ! -t 0 ] || [ ! -t 1 ]; then
        cmd_status
        return 0
    fi

    local -a items=()
    local cur_idx=0
    local idx=0

    # Collect preset themes
    for entry in "${PRESET_THEMES[@]}"; do
        IFS='|' read -r name c_cpu c_gpu c_ram c_swp c_dsk c_ld desc <<< "$entry"
        items+=( "$name|$c_cpu|$c_gpu|$c_ram|$c_swp|$c_dsk|$c_ld|$desc|preset" )
        if [ "$name" = "$CURRENT_THEME" ]; then
            cur_idx=$idx
        fi
        idx=$(( idx + 1 ))
    done

    # Collect custom themes
    for f in "$THEMES_DIR"/*.theme; do
        if [ -f "$f" ]; then
            local cname="${f##*/}"
            cname="${cname%.theme}"
            local BAR_MODE_CPU="load" BAR_MODE_GPU="cyan" BAR_MODE_RAM="load"
            local BAR_MODE_SWP="mag" BAR_MODE_DSK="load" BAR_MODE_LD="load"
            # shellcheck source=/dev/null
            source "$f" 2>/dev/null || true
            items+=( "$cname|$BAR_MODE_CPU|$BAR_MODE_GPU|$BAR_MODE_RAM|$BAR_MODE_SWP|$BAR_MODE_DSK|$BAR_MODE_LD|Custom user theme|custom" )
            if [ "$cname" = "$CURRENT_THEME" ]; then
                cur_idx=$idx
            fi
            idx=$(( idx + 1 ))
        fi
    done

    local total=${#items[@]}
    if (( total == 0 )); then
        printf 'No themes available.\n'
        return 1
    fi

    # Terminal state preservation
    local old_stty
    old_stty=$(stty -g 2>/dev/null || true)

    cleanup_picker() {
        printf '\033[?25h\033[?1049l'
        if [ -n "$old_stty" ]; then
            stty "$old_stty" 2>/dev/null || true
        else
            stty echo icanon 2>/dev/null || true
        fi
    }
    trap cleanup_picker EXIT INT TERM

    # Switch to alt screen buffer & hide cursor
    printf '\033[?1049h\033[?25l'
    stty -echo -icanon min 1 time 0 2>/dev/null || true

    local selected_theme=""

    while true; do
        # Move cursor home and clear
        printf '\033[H\033[2J'

        # Banner
        printf '\033[1;36m  ┌─────────────────────────────────────────────────────────────┐\033[0m\n'
        printf '\033[1;36m  │\033[0m                 \033[1mStatD Theme Selector\033[0m                        \033[1;36m│\033[0m\n'
        printf '\033[1;36m  │\033[0m   \033[2m↑/↓ or j/k to browse  ·  Enter to apply  ·  q to exit\033[0m      \033[1;36m│\033[0m\n'
        printf '\033[1;36m  └─────────────────────────────────────────────────────────────┘\033[0m\n\n'

        # List themes with cursor indicator
        local i
        for (( i=0; i<total; i++ )); do
            IFS='|' read -r t_name t_cpu t_gpu t_ram t_swp t_dsk t_ld t_desc t_type <<< "${items[i]}"
            local active_tag=""
            if [ "$t_name" = "$CURRENT_THEME" ]; then
                active_tag="\033[32m [active]\033[0m"
            fi

            if (( i == cur_idx )); then
                printf '  \033[1;36m▸ \033[1;37m%-11s\033[0m%b \033[2m— %s\033[0m\n' "$t_name" "$active_tag" "$t_desc"
            else
                printf '    \033[2m%-11s\033[0m%b \033[2m— %s\033[0m\n' "$t_name" "$active_tag" "$t_desc"
            fi
        done

        # Live Preview Box
        IFS='|' read -r cur_name cur_cpu cur_gpu cur_ram cur_swp cur_dsk cur_ld cur_desc cur_type <<< "${items[cur_idx]}"

        printf '\n\033[1;34m  ┌─ Live Preview: \033[1;37m%-12s\033[0;1;34m──────────────────────────────────────┐\033[0m\n' "$cur_name"

        printf '\033[1;34m  │\033[0m  CPU  '
        bar_gradient 52 24 "$cur_cpu"
        printf '  52%%  \033[2m(%-8s)\033[0m \033[1;34m│\033[0m\n' "$cur_cpu"

        printf '\033[1;34m  │\033[0m  GPU  '
        bar_gradient 74 24 "$cur_gpu"
        printf '  74%%  \033[2m(%-8s)\033[0m \033[1;34m│\033[0m\n' "$cur_gpu"

        printf '\033[1;34m  │\033[0m  RAM  '
        bar_gradient 61 24 "$cur_ram"
        printf '  61%%  \033[2m(%-8s)\033[0m \033[1;34m│\033[0m\n' "$cur_ram"

        printf '\033[1;34m  │\033[0m  SWP  '
        bar_gradient 28 24 "$cur_swp"
        printf '  28%%  \033[2m(%-8s)\033[0m \033[1;34m│\033[0m\n' "$cur_swp"

        printf '\033[1;34m  │\033[0m  DSK  '
        bar_gradient 56 24 "$cur_dsk"
        printf '  56%%  \033[2m(%-8s)\033[0m \033[1;34m│\033[0m\n' "$cur_dsk"

        printf '\033[1;34m  │\033[0m  LD   '
        bar_gradient 68 24 "$cur_ld"
        printf '  68%%  \033[2m(%-8s)\033[0m \033[1;34m│\033[0m\n' "$cur_ld"
        printf '\033[1;34m  └─────────────────────────────────────────────────────────────┘\033[0m\n'

        # Key reading
        local key="" rest=""
        IFS= read -rsn1 key || break
        if [[ "$key" == $'\x1b' ]]; then
            if read -rsn2 -t 1 rest 2>/dev/null; then
                case "$rest" in
                    "[A"|"OA") key="UP" ;;
                    "[B"|"OB") key="DOWN" ;;
                    *) key="ESC" ;;
                esac
            else
                key="ESC"
            fi
        elif [ -z "$key" ] || [[ "$key" == $'\r' || "$key" == $'\n' || "$key" == " " ]]; then
            key="ENTER"
        fi

        case "$key" in
            UP|k|K|w|W)
                cur_idx=$(( (cur_idx - 1 + total) % total ))
                ;;
            DOWN|j|J|s|S)
                cur_idx=$(( (cur_idx + 1) % total ))
                ;;
            "\\")
                trigger_dance_party
                ;;
            ENTER)
                selected_theme="$cur_name"
                break
                ;;
            q|Q|ESC)
                selected_theme=""
                break
                ;;
        esac
    done

    cleanup_picker
    trap - EXIT INT TERM

    if [ -n "$selected_theme" ]; then
        cmd_set "$selected_theme"
    else
        printf '  Theme selection cancelled. No changes made.\n\n'
    fi
}

# ------------------------------------------------------------
# Main Dispatch
# ------------------------------------------------------------
subcmd="${1:-}"
case "$subcmd" in
    "")
        if [ -t 0 ] && [ -t 1 ]; then
            interactive_picker
        else
            cmd_status
        fi
        ;;
    interactive|select|tui|ui)
        interactive_picker
        ;;
    dance|party)
        trigger_dance_party
        ;;
    status|info)
        cmd_status
        ;;
    list|ls)
        cmd_list
        ;;
    set|apply|use)
        shift
        cmd_set "${1:-}"
        ;;
    preview)
        shift
        cmd_preview "${1:-}"
        ;;
    set-color|color)
        shift
        cmd_set_color "$@"
        ;;
    create|new)
        shift
        cmd_create "${1:-}"
        ;;
    reset|default)
        cmd_reset
        ;;
    -h|--help|help)
        show_help
        ;;
    -v|--version|version)
        printf 'statd-theme %s\n' "$VERSION"
        ;;
    *)
        # If user directly typed: statd theme cyberpunk
        if [ $# -eq 1 ]; then
            cmd_set "$1"
        else
            printf 'Unknown command: %s (see "statd theme --help")\n' "$subcmd" >&2
            exit 1
        fi
        ;;
esac
