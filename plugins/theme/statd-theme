render_preview_bar() {
    local label="$1" pct="$2" mode="$3" width="${4:-22}"
    printf '  %-4s ' "$label"
    bar_gradient "$pct" "$width" "$mode"
    printf '  \033[2m(%s)\033[0m\n' "$mode"
}

render_full_preview() {
    local theme_name="$1" c_cpu="$2" c_gpu="$3" c_ram="$4" c_swp="$5" c_dsk="$6" c_ld="$7"
    printf '\n  \033[1;36mTheme Preview:\033[0m \033[1m%s\033[0m\n\n' "$theme_name"
    render_preview_bar "CPU" 45 "$c_cpu" 24
    render_preview_bar "GPU" 72 "$c_gpu" 24
    render_preview_bar "RAM" 60 "$c_ram" 24
    render_preview_bar "SWP" 30 "$c_swp" 24
    render_preview_bar "DSK" 55 "$c_dsk" 24
    render_preview_bar "LD"  68 "$c_ld"  24
    printf '\n'
}

