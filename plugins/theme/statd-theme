if [ -n "$LIB_DIR" ]; then
    # shellcheck source=/dev/null
    source "$LIB_DIR/colors.sh" 2>/dev/null || true
    # shellcheck source=/dev/null
    source "$LIB_DIR/render.sh" 2>/dev/null || true
fi

# Self-contained gradient bar renderer (matches statd lib/render.sh)
_STATD_EMPTY='░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░'
_STATD_EMPTY="${_STATD_EMPTY}${_STATD_EMPTY}"

bar_grad_level() {
    printf '%d' $(( (${1:-0} * 5 + 127) / 255 ))
}

bar_gradient() {
    local pct=$1 width=${2:-20} mode=${3:-load}
    [[ "$pct" =~ ^[0-9]+$ ]] || pct=0
    (( pct <   0 )) && pct=0
    (( pct > 100 )) && pct=100
    (( width < 1 )) && width=1

    local filled=$(( pct * width / 100 ))
    local empty=$(( width - filled ))
    local denom=$(( width > 1 ? width - 1 : 1 ))

    local i t r g b rl gl bl idx tt
    local custom=0 cr1=0 cg1=0 cb1=0 cr2=0 cg2=0 cb2=0
    if [[ "$mode" =~ ^([0-9]+),([0-9]+),([0-9]+):([0-9]+),([0-9]+),([0-9]+)$ ]]; then
        custom=1
        cr1="${BASH_REMATCH[1]}"; cg1="${BASH_REMATCH[2]}"; cb1="${BASH_REMATCH[3]}"
        cr2="${BASH_REMATCH[4]}"; cg2="${BASH_REMATCH[5]}"; cb2="${BASH_REMATCH[6]}"
    fi

    for (( i=0; i<filled; i++ )); do
        t=$(( i * 1000 / denom ))
        if (( custom )); then
            r=$(( cr1 + (cr2 - cr1) * t / 1000 ))
            g=$(( cg1 + (cg2 - cg1) * t / 1000 ))
            b=$(( cb1 + (cb2 - cb1) * t / 1000 ))
        else
            case "$mode" in
                cyan)
                    r=$(( 0   + (30  - 0)   * t / 1000 ))
                    g=$(( 240 + (110 - 240) * t / 1000 ))
                    b=$(( 255 + (220 - 255) * t / 1000 ))
                    ;;
                mag)
                    r=$(( 220 + (140 - 220) * t / 1000 ))
                    g=$(( 130 + (0   - 130) * t / 1000 ))
                    b=$(( 255 + (180 - 255) * t / 1000 ))
                    ;;
                amber)
                    r=$(( 255 + (220 - 255) * t / 1000 ))
                    g=$(( 180 + (40  - 180) * t / 1000 ))
                    b=$(( 20  + (0   - 20)  * t / 1000 ))
                    ;;
                purple|pink)
                    r=$(( 235 + (140 - 235) * t / 1000 ))
                    g=$(( 80  + (0   - 80)  * t / 1000 ))
                    b=$(( 255 + (200 - 255) * t / 1000 ))
                    ;;
                matrix)
                    r=$(( 40  + (0   - 40)  * t / 1000 ))
                    g=$(( 255 + (130 - 255) * t / 1000 ))
                    b=$(( 60  + (20  - 60)  * t / 1000 ))
                    ;;
                nord)
                    r=$(( 143 + (94  - 143) * t / 1000 ))
                    g=$(( 188 + (129 - 188) * t / 1000 ))
                    b=$(( 187 + (172 - 187) * t / 1000 ))
                    ;;
                load|*)
                    if (( t <= 500 )); then
                        tt=$(( t * 2 ))
                        r=$(( (225 * tt) / 1000 ))
                        g=200
                        b=0
                    else
                        tt=$(( (t - 500) * 2 ))
                        r=225
                        g=$(( 200 + (40 - 200) * tt / 1000 ))
                        b=0
                    fi
                    ;;
            esac
        fi
        rl=$(bar_grad_level "$r")
        gl=$(bar_grad_level "$g")
        bl=$(bar_grad_level "$b")
        idx=$(( 16 + 36*rl + 6*gl + bl ))
        printf '\033[38;5;%dm\xe2\x96\x88' "$idx"
    done

    printf '\033[90m'
    (( empty > 0 )) && printf '%s' "${_STATD_EMPTY:0:$empty}"
    printf '\033[0m'
}

# Load current configuration
if [ -f "$CONFIG_FILE" ]; then
    # shellcheck source=/dev/null
    source "$CONFIG_FILE" 2>/dev/null || true
fi

CURRENT_THEME="${THEME:-default}"
CURRENT_CPU="${BAR_MODE_CPU:-load}"
CURRENT_GPU="${BAR_MODE_GPU:-cyan}"
CURRENT_RAM="${BAR_MODE_RAM:-load}"
CURRENT_SWP="${BAR_MODE_SWP:-mag}"
CURRENT_DSK="${BAR_MODE_DSK:-load}"
CURRENT_LD="${BAR_MODE_LD:-load}"

# Premade theme definitions: <name>|<cpu>|<gpu>|<ram>|<swp>|<dsk>|<ld>|<desc>
PRESET_THEMES=(
    "default|load|cyan|load|mag|load|load|Standard StatD (Green load, Cyan GPU, Magenta Swap)"
    "cyberpunk|amber|cyan|purple|mag|amber|cyan|High-contrast Night City (Amber, Cyan, Hot Pink)"
    "nord|nord|cyan|nord|mag|nord|cyan|Arctic, Frost blue, and Polar night tones"
    "dracula|purple|cyan|load|mag|amber|purple|Dark fantasy palette (Purple, Cyan, Emerald)"
    "catppuccin|purple|cyan|amber|mag|nord|purple|Soothing pastel palette (Lavender, Teal, Peach)"
    "matrix|matrix|matrix|matrix|matrix|matrix|matrix|Pure terminal lime, emerald, and dark green"
    "sunset|amber|purple|amber|mag|amber|purple|Fiery sunset gradient (Crimson, Orange, Violet)"
    "monokai|load|cyan|purple|mag|amber|load|Vibrant coding palette (Lime, Cyan, Magenta)"
    "synthwave|purple|cyan|mag|purple|cyan|mag|80s retro neon aesthetic (Hot Pink, Neon Cyan)"
)

# Set variable in config file
_set_config() {
    local key="$1" val="$2"
    if grep -q "^${key}=" "$CONFIG_FILE" 2>/dev/null; then
        local tmp
        tmp=$(mktemp)
        awk -v k="$key" -v v="$val" '
            $0 ~ "^"k"=" { print k"=\""v"\""; next }
            { print }
        ' "$CONFIG_FILE" > "$tmp" && mv "$tmp" "$CONFIG_FILE"
    else
        printf '%s="%s"\n' "$key" "$val" >> "$CONFIG_FILE"
    fi
}

