_SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
_PREFIX_DIR="$(dirname "$_SCRIPT_DIR")"
LIB_DIR=""

for _d in \
    "$_SCRIPT_DIR/../../lib" \
    "$(dirname "$_PREFIX_DIR")/lib" \
    "$_PREFIX_DIR/lib/statd" \
    "/usr/local/lib/statd" \
    "/opt/homebrew/lib/statd" \
    "$HOME/.local/lib/statd" \
    "/usr/lib/statd" \
    "/usr/share/statd/lib"
do
    if [ -d "$_d" ] && [ -f "$_d/render.sh" ]; then
        LIB_DIR="$_d"
        break
    fi
