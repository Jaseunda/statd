    "/opt/homebrew/lib/statd" \
    "$HOME/.local/lib/statd" \
    "/usr/lib/statd" \
    "/usr/share/statd/lib"
do
    if [ -d "$_d" ] && [ -f "$_d/render.sh" ]; then
        LIB_DIR="$_d"
        break
    fi
done

