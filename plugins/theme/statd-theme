cmd_list() {
    printf '\n  \033[1mAvailable StatD Themes\033[0m\n\n'
    for entry in "${PRESET_THEMES[@]}"; do
        IFS='|' read -r name c_cpu c_gpu c_ram c_swp c_dsk c_ld desc <<< "$entry"
        local marker=" "
        if [ "$name" = "$CURRENT_THEME" ]; then
            marker="\033[32m●\033[0m"
            printf '  %b \033[1;32m%-12s\033[0m \033[32m[active]\033[0m — %s\n' "$marker" "$name" "$desc"
        else
            marker="\033[2m○\033[0m"
            printf '  %b \033[1m%-12s\033[0m — %s\n' "$marker" "$name" "$desc"
        fi
        printf '    '
        bar_gradient 60 6 "$c_cpu"
        printf ' '
        bar_gradient 75 6 "$c_gpu"
        printf ' '
        bar_gradient 50 6 "$c_ram"
        printf ' '
        bar_gradient 30 6 "$c_swp"
        printf ' '
        bar_gradient 65 6 "$c_dsk"
        printf ' '
        bar_gradient 55 6 "$c_ld"
        printf '  \033[2m(CPU GPU RAM SWP DSK LD)\033[0m\n\n'
    done

    # Check for custom saved themes
    for f in "$THEMES_DIR"/*.theme; do
        if [ -f "$f" ]; then
            local cname="${f##*/}"
            cname="${cname%.theme}"
            local BAR_MODE_CPU="load" BAR_MODE_GPU="cyan" BAR_MODE_RAM="load"
            local BAR_MODE_SWP="mag" BAR_MODE_DSK="load" BAR_MODE_LD="load"
            # shellcheck source=/dev/null
            source "$f" 2>/dev/null || true
            local marker="\033[35m★\033[0m"
            if [ "$cname" = "$CURRENT_THEME" ]; then
                printf '  %b \033[1;32m%-12s\033[0m \033[32m[active custom]\033[0m\n' "$marker" "$cname"
            else
                printf '  %b \033[1m%-12s\033[0m \033[35m[custom]\033[0m\n' "$marker" "$cname"
            fi
            printf '    '
            bar_gradient 60 6 "$BAR_MODE_CPU"
            printf ' '
            bar_gradient 75 6 "$BAR_MODE_GPU"
            printf ' '
            bar_gradient 50 6 "$BAR_MODE_RAM"
            printf ' '
            bar_gradient 30 6 "$BAR_MODE_SWP"
            printf ' '
            bar_gradient 65 6 "$BAR_MODE_DSK"
            printf ' '
            bar_gradient 55 6 "$BAR_MODE_LD"
            printf '  \033[2m(CPU GPU RAM SWP DSK LD)\033[0m\n\n'
        fi
    done

    printf '  Interactive picker: \033[1mstatd theme\033[0m\n'
    printf '  Apply theme:        \033[1mstatd theme set <name>\033[0m\n'
    printf '  Preview theme:      \033[1mstatd theme preview <name>\033[0m\n\n'
}

cmd_set() {
    local target="$1"
    if [ -z "$target" ]; then
        printf 'Usage: statd theme set <theme_name>\n' >&2
        printf 'Run "statd theme list" to see available themes.\n' >&2
        return 1
    fi

    # Check preset themes
    for entry in "${PRESET_THEMES[@]}"; do
        IFS='|' read -r name c_cpu c_gpu c_ram c_swp c_dsk c_ld desc <<< "$entry"
        if [ "$name" = "$target" ]; then
            _set_config "THEME" "$name"
            _set_config "BAR_MODE_CPU" "$c_cpu"
            _set_config "BAR_MODE_GPU" "$c_gpu"
            _set_config "BAR_MODE_RAM" "$c_ram"
            _set_config "BAR_MODE_SWP" "$c_swp"
            _set_config "BAR_MODE_DSK" "$c_dsk"
            _set_config "BAR_MODE_LD" "$c_ld"
            printf '  \033[32m+\033[0m  Applied theme: \033[1;32m%s\033[0m\n' "$name"
            render_full_preview "$name" "$c_cpu" "$c_gpu" "$c_ram" "$c_swp" "$c_dsk" "$c_ld"
            return 0
        fi
    done

    # Check custom theme file
    local custom_file="$THEMES_DIR/$target.theme"
    if [ -f "$custom_file" ]; then
        # shellcheck source=/dev/null
        source "$custom_file"
        _set_config "THEME" "$target"
        _set_config "BAR_MODE_CPU" "${BAR_MODE_CPU:-load}"
        _set_config "BAR_MODE_GPU" "${BAR_MODE_GPU:-cyan}"
        _set_config "BAR_MODE_RAM" "${BAR_MODE_RAM:-load}"
        _set_config "BAR_MODE_SWP" "${BAR_MODE_SWP:-mag}"
        _set_config "BAR_MODE_DSK" "${BAR_MODE_DSK:-load}"
        _set_config "BAR_MODE_LD" "${BAR_MODE_LD:-load}"
        printf '  \033[32m+\033[0m  Applied custom theme: \033[1;32m%s\033[0m\n' "$target"
        render_full_preview "$target" "$BAR_MODE_CPU" "$BAR_MODE_GPU" "$BAR_MODE_RAM" "$BAR_MODE_SWP" "$BAR_MODE_DSK" "$BAR_MODE_LD"
        return 0
    fi

    printf '  \033[31mx\033[0m  Theme "%s" not found.\n' "$target" >&2
    printf '     Run "statd theme list" to view available themes.\n' >&2
    return 1
}

cmd_preview() {
    local target="$1"
    if [ -z "$target" ]; then
        printf 'Usage: statd theme preview <theme_name>\n' >&2
        return 1
    fi
    for entry in "${PRESET_THEMES[@]}"; do
        IFS='|' read -r name c_cpu c_gpu c_ram c_swp c_dsk c_ld desc <<< "$entry"
        if [ "$name" = "$target" ]; then
            render_full_preview "$name" "$c_cpu" "$c_gpu" "$c_ram" "$c_swp" "$c_dsk" "$c_ld"
            return 0
        fi
    done
    local custom_file="$THEMES_DIR/$target.theme"
    if [ -f "$custom_file" ]; then
        # shellcheck source=/dev/null
        source "$custom_file"
        render_full_preview "$target" "${BAR_MODE_CPU:-load}" "${BAR_MODE_GPU:-cyan}" "${BAR_MODE_RAM:-load}" "${BAR_MODE_SWP:-mag}" "${BAR_MODE_DSK:-load}" "${BAR_MODE_LD:-load}"
        return 0
    fi
    printf '  \033[31mx\033[0m  Theme "%s" not found.\n' "$target" >&2
    return 1
}

cmd_set_color() {
    local metric="$1" color="$2"
    if [ -z "$metric" ] || [ -z "$color" ]; then
        printf 'Usage: statd theme set-color <metric> <color_or_gradient>\n' >&2
        printf 'Metrics: cpu, gpu, ram, swp, dsk, ld\n' >&2
        printf 'Colors:  cyan, amber, purple, matrix, nord, load, mag, tokyo, gruvbox, forest, rose, ocean, emerald, lava, gold, sakura, stealth, or R1,G1,B1:R2,G2,B2\n' >&2
        return 1
    fi

    metric=$(echo "$metric" | tr '[:upper:]' '[:lower:]')
    local var=""
    case "$metric" in
        cpu) var="BAR_MODE_CPU" ;;
        gpu) var="BAR_MODE_GPU" ;;
        ram|mem) var="BAR_MODE_RAM" ;;
        swp|swap) var="BAR_MODE_SWP" ;;
        dsk|disk) var="BAR_MODE_DSK" ;;
        ld|load) var="BAR_MODE_LD" ;;
        net|network) var="BAR_MODE_NET" ;;
        *)
            printf 'Unknown metric: %s (choose: cpu, gpu, ram, swp, dsk, ld, net)\n' "$metric" >&2
            return 1
            ;;
    esac

    _set_config "$var" "$color"
    _set_config "THEME" "custom"
    printf '  \033[32m+\033[0m  Set \033[1m%s\033[0m color to: \033[1;36m%s\033[0m\n\n' "$metric" "$color"
    render_preview_bar "$metric" 70 "$color" 24
    printf '\n'
}

cmd_create() {
    local name="$1"
    if [ -z "$name" ]; then
        printf 'Usage: statd theme create <theme_name>\n' >&2
        return 1
    fi

    local target_file="$THEMES_DIR/$name.theme"
    cat > "$target_file" <<EOF
# StatD Theme: $name
BAR_MODE_CPU="${BAR_MODE_CPU:-load}"
BAR_MODE_GPU="${BAR_MODE_GPU:-cyan}"
BAR_MODE_RAM="${BAR_MODE_RAM:-load}"
BAR_MODE_SWP="${BAR_MODE_SWP:-mag}"
BAR_MODE_DSK="${BAR_MODE_DSK:-load}"
BAR_MODE_LD="${BAR_MODE_LD:-load}"
EOF
    printf '  \033[32m+\033[0m  Created custom theme: \033[1;32m%s\033[0m at %s\n' "$name" "$target_file"
    printf '     Edit colors in this file or customize with:\n'
    printf '     statd theme set-color <metric> <color>\n\n'
}

cmd_reset() {
    _set_config "THEME" "default"
    _set_config "BAR_MODE_CPU" "load"
    _set_config "BAR_MODE_GPU" "cyan"
    _set_config "BAR_MODE_RAM" "load"
    _set_config "BAR_MODE_SWP" "mag"
    _set_config "BAR_MODE_DSK" "load"
    _set_config "BAR_MODE_LD" "load"
    printf '  \033[32m+\033[0m  Reset theme to \033[1mdefault\033[0m (Green load, Cyan GPU, Magenta Swap).\n\n'
}

_render_picker_row() {
    local label="$1" pct="$2" mode="$3" c_border="${4:-\033[1;34m}"
    local mode_tag="($mode)"
    (( ${#mode_tag} > 12 )) && mode_tag="(custom)"
    printf '%b  │\033[0m  %-3s  ' "$c_border" "$label"
    bar_gradient "$pct" 28 "$mode"
    printf '  %3d%%  \033[2m%-12s\033[0m      %b│\033[0m\n' "$pct" "$mode_tag" "$c_border"
}

# ------------------------------------------------------------
# Easter Egg: Benchmark & Stress Test Simulation (6 seconds, 60 FPS)
# Triggered by pressing "\"
# Ramps up preview bars to 100% load with dynamic thermal colors
# ------------------------------------------------------------
trigger_dance_party() {
    local t_start
    t_start=$(date +%s)
    local frame=0

    printf '\033[?25l'

    while :; do
        local now
        now=$(date +%s)
        local elapsed_s=$(( now - t_start ))
        (( elapsed_s >= 6 )) && break
        frame=$(( frame + 1 ))

        # Pick dynamic color cycling for borders and title
        local border_colors=("\033[1;35m" "\033[1;36m" "\033[1;33m" "\033[1;32m" "\033[1;31m" "\033[1;34m")
        local c_border="${border_colors[$(( (frame / 4) % 6 ))]}"
        local title_colors=("\033[1;97m" "\033[1;93m" "\033[1;96m" "\033[1;95m" "\033[1;92m")
        local c_title="${title_colors[$(( (frame / 3) % 5 ))]}"

        local timer_text
        timer_text=$(printf '[%02d.%01ds]' "$(( 5 - elapsed_s ))" "$(( (60 - (frame % 60)) * 10 / 60 ))")

        local head_text
        if (( elapsed_s < 2 )); then
            head_text="BENCHMARK RAMP-UP TEST"
        elif (( elapsed_s < 5 )); then
            head_text="BENCHMARK FULL LOAD (STRESS TEST)"
        else
            head_text="COOL DOWN & RESTORING"
        fi

        # Move cursor home and clear
        printf '\033[H\033[2J'

        # Banner (same format, animated text and colors)
        printf '%b  ┌─────────────────────────────────────────────────────────────┐\033[0m\n' "$c_border"
        printf '%b  │\033[0m   %b%-45s%b  \033[1;33m%-7s\033[0m    %b│\033[0m\n' "$c_border" "$c_title" "$head_text" "$c_border" "$timer_text" "$c_border"
        printf '%b  │\033[0m    \033[2m↑/↓ or j/k to browse  ·  Enter to apply  ·  q to exit\033[0m    %b│\033[0m\n' "$c_border" "$c_border"
        printf '%b  └─────────────────────────────────────────────────────────────┘\033[0m\n\n' "$c_border"

        # List themes with cursor indicator (windowed for terminal height)
        local term_lines=$(tput lines 2>/dev/null || echo 24)
        [[ "$term_lines" =~ ^[0-9]+$ ]] || term_lines=24
        local max_visible=$(( term_lines - 16 ))
        (( max_visible < 6 )) && max_visible=6
        (( max_visible > total )) && max_visible=$total

        local win_start=$(( cur_idx - max_visible / 2 ))
        (( win_start < 0 )) && win_start=0
        local win_end=$(( win_start + max_visible ))
        if (( win_end > total )); then
            win_end=$total
            win_start=$(( win_end - max_visible ))
            (( win_start < 0 )) && win_start=0
        fi

        local i
        for (( i=win_start; i<win_end; i++ )); do
            IFS='|' read -r t_name t_cpu t_gpu t_ram t_swp t_dsk t_ld t_desc t_type <<< "${items[i]}"
            local active_tag=""
            if [ "$t_name" = "$CURRENT_THEME" ]; then
                active_tag="\033[32m [active]\033[0m"
            fi

            if (( i == cur_idx )); then
                printf '  %b▸ \033[1;37m%-11s\033[0m%b \033[2m— %s\033[0m\n' "$c_title" "$t_name" "$active_tag" "$t_desc"
            else
                printf '    \033[2m%-11s\033[0m%b \033[2m— %s\033[0m\n' "$t_name" "$active_tag" "$t_desc"
            fi
        done

        # Live Preview Box (same format, simulated benchmark stress bars)
        IFS='|' read -r cur_name cur_cpu cur_gpu cur_ram cur_swp cur_dsk cur_ld cur_desc cur_type <<< "${items[cur_idx]}"

        # Calculate benchmark ramp / saturation / cooldown values for preview bars
        local p_base=15
        local m_mode="load"

        if (( elapsed_s < 2 )); then
            local ramp_ratio=$(( elapsed_s * 50 + (frame % 30) * 50 / 30 ))
            p_base=$(( 15 + ramp_ratio * 85 / 100 ))
            (( p_base > 100 )) && p_base=100
            if (( p_base < 60 )); then m_mode="cyan"
            elif (( p_base < 85 )); then m_mode="amber"
            else m_mode="load"
            fi
        elif (( elapsed_s < 5 )); then
            p_base=$(( 96 + (frame * 7) % 5 ))
            (( p_base > 100 )) && p_base=100
            local party_modes=("amber" "purple" "load" "mag" "cyan")
            m_mode="${party_modes[$(( (frame / 8) % 5 ))]}"
        else
            local cool_pct=$(( (6 - elapsed_s) * 75 ))
            p_base=$(( 20 + cool_pct ))
            (( p_base > 100 )) && p_base=100
            m_mode="cyan"
        fi

        local p_cpu=$p_base
        local p_gpu=$(( p_base > 5 ? p_base - 2 : p_base ))
        local p_ram=$(( p_base > 10 ? p_base - 6 : p_base ))
        local p_swp=$(( p_base * 75 / 100 ))
        local p_dsk=$(( p_base > 15 ? p_base - 8 : p_base ))
        local p_ld=$p_base

        printf '\n%b  ┌─ Live Preview: \033[1;37m%-12s\033[0m%b \033[1;33m[BENCHMARK 60FPS]\033[0m%b ──────────────┐\033[0m\n' "$c_border" "$cur_name" "$c_border" "$c_border"

        _render_picker_row "CPU" "$p_cpu" "$m_mode" "$c_border"
        _render_picker_row "GPU" "$p_gpu" "$m_mode" "$c_border"
        _render_picker_row "RAM" "$p_ram" "$m_mode" "$c_border"
        _render_picker_row "SWP" "$p_swp" "$m_mode" "$c_border"
        _render_picker_row "DSK" "$p_dsk" "$m_mode" "$c_border"
        _render_picker_row "LD"  "$p_ld"  "$m_mode" "$c_border"
        printf '%b  └─────────────────────────────────────────────────────────────┘\033[0m\n' "$c_border"

        sleep 0.016
    done
}

# ------------------------------------------------------------
# Interactive TUI Theme Selector
# ------------------------------------------------------------
interactive_picker() {
    # If not connected to a terminal, fall back to status
    if [ ! -t 0 ] || [ ! -t 1 ]; then
        cmd_status
        return 0
    fi

    local -a items=()
    local cur_idx=0
    local idx=0

    # Collect preset themes
    for entry in "${PRESET_THEMES[@]}"; do
        IFS='|' read -r name c_cpu c_gpu c_ram c_swp c_dsk c_ld desc <<< "$entry"
        items+=( "$name|$c_cpu|$c_gpu|$c_ram|$c_swp|$c_dsk|$c_ld|$desc|preset" )
        if [ "$name" = "$CURRENT_THEME" ]; then
            cur_idx=$idx
        fi
        idx=$(( idx + 1 ))
    done

    # Collect custom themes
    for f in "$THEMES_DIR"/*.theme; do
        if [ -f "$f" ]; then
            local cname="${f##*/}"
            cname="${cname%.theme}"
            local BAR_MODE_CPU="load" BAR_MODE_GPU="cyan" BAR_MODE_RAM="load"
            local BAR_MODE_SWP="mag" BAR_MODE_DSK="load" BAR_MODE_LD="load"
            # shellcheck source=/dev/null
            source "$f" 2>/dev/null || true
            items+=( "$cname|$BAR_MODE_CPU|$BAR_MODE_GPU|$BAR_MODE_RAM|$BAR_MODE_SWP|$BAR_MODE_DSK|$BAR_MODE_LD|Custom user theme|custom" )
            if [ "$cname" = "$CURRENT_THEME" ]; then
                cur_idx=$idx
            fi
            idx=$(( idx + 1 ))
        fi
    done

    local total=${#items[@]}
    if (( total == 0 )); then
        printf 'No themes available.\n'
        return 1
    fi

    # Terminal state preservation
    local old_stty
    old_stty=$(stty -g 2>/dev/null || true)

    cleanup_picker() {
        printf '\033[?25h\033[?1049l'
        if [ -n "$old_stty" ]; then
            stty "$old_stty" 2>/dev/null || true
        else
            stty echo icanon 2>/dev/null || true
        fi
    }
    trap cleanup_picker EXIT INT TERM

    # Switch to alt screen buffer & hide cursor
    printf '\033[?1049h\033[?25l'
    stty -echo -icanon min 1 time 0 2>/dev/null || true

    local selected_theme=""

    while true; do
        # Move cursor home and clear
        printf '\033[H\033[2J'

        # Header
        printf '\n  \033[1;37mStatD Theme Selector\033[0m\n'
        printf '  \033[2m↑/↓ or j/k to browse  ·  Enter to apply  ·  q to exit\033[0m\n\n'

        # List themes with cursor indicator (windowed for terminal height)
        local term_lines=$(tput lines 2>/dev/null || echo 24)
        [[ "$term_lines" =~ ^[0-9]+$ ]] || term_lines=24
        local max_visible=$(( term_lines - 16 ))
        (( max_visible < 6 )) && max_visible=6
        (( max_visible > total )) && max_visible=$total

        local win_start=$(( cur_idx - max_visible / 2 ))
        (( win_start < 0 )) && win_start=0
        local win_end=$(( win_start + max_visible ))
        if (( win_end > total )); then
            win_end=$total
            win_start=$(( win_end - max_visible ))
            (( win_start < 0 )) && win_start=0
        fi

        local i
        for (( i=win_start; i<win_end; i++ )); do
            IFS='|' read -r t_name t_cpu t_gpu t_ram t_swp t_dsk t_ld t_desc t_type <<< "${items[i]}"
            local active_tag=""
            local pfx_w=18
            if [ "$t_name" = "$CURRENT_THEME" ]; then
                active_tag="\033[32m [active]\033[0m"
                pfx_w=27
            fi

            # Keep description inside the 65-column box boundary (max column 64)
            local max_desc_w=$(( 64 - pfx_w ))
            local disp_desc="$t_desc"
            if (( ${#disp_desc} > max_desc_w )); then
                disp_desc="${disp_desc:0:$(( max_desc_w - 1 ))}…"
            fi

            if (( i == cur_idx )); then
                printf '  \033[1;36m▸ \033[1;37m%-11s\033[0m%b \033[2m— %s\033[0m\n' "$t_name" "$active_tag" "$disp_desc"
            else
                printf '    \033[2m%-11s\033[0m%b \033[2m— %s\033[0m\n' "$t_name" "$active_tag" "$disp_desc"
            fi
        done

        # Live Preview Box
        IFS='|' read -r cur_name cur_cpu cur_gpu cur_ram cur_swp cur_dsk cur_ld cur_desc cur_type <<< "${items[cur_idx]}"

        printf '\n\033[1;34m  ┌─ Live Preview: \033[1;37m%-12s\033[0;1;34m─────────────────────────────────┐\033[0m\n' "$cur_name"

        _render_picker_row "CPU" 52 "$cur_cpu"
        _render_picker_row "GPU" 74 "$cur_gpu"
        _render_picker_row "RAM" 61 "$cur_ram"
        _render_picker_row "SWP" 28 "$cur_swp"
        _render_picker_row "DSK" 56 "$cur_dsk"
        _render_picker_row "LD"  68 "$cur_ld"
        printf '\033[1;34m  └─────────────────────────────────────────────────────────────┘\033[0m\n'

        # Key reading
        local key="" rest=""
        IFS= read -rsn1 key || break
        if [[ "$key" == $'\x1b' ]]; then
            if read -rsn2 -t 1 rest 2>/dev/null; then
                case "$rest" in
                    "[A"|"OA") key="UP" ;;
                    "[B"|"OB") key="DOWN" ;;
                    *) key="ESC" ;;
                esac
            else
                key="ESC"
            fi
        elif [ -z "$key" ] || [[ "$key" == $'\r' || "$key" == $'\n' || "$key" == " " ]]; then
            key="ENTER"
        fi

        case "$key" in
            UP|k|K|w|W)
                cur_idx=$(( (cur_idx - 1 + total) % total ))
                ;;
            DOWN|j|J|s|S)
                cur_idx=$(( (cur_idx + 1) % total ))
                ;;
            "\\")
                trigger_dance_party
                ;;
            ENTER)
                selected_theme="$cur_name"
                break
                ;;
            q|Q|ESC)
                selected_theme=""
                break
                ;;
        esac
    done

    cleanup_picker
    trap - EXIT INT TERM

    if [ -n "$selected_theme" ]; then
        cmd_set "$selected_theme"
    else
        printf '  Theme selection cancelled. No changes made.\n\n'
    fi
}

cmd_update() {
    local statd_cmd=""
    if [ -x "$(dirname "$0")/../../statd" ]; then
        statd_cmd="$(dirname "$0")/../../statd"
    elif command -v statd >/dev/null 2>&1; then
        statd_cmd="statd"
    fi
    if [ -n "$statd_cmd" ]; then
        exec "$statd_cmd" plugin update theme "$@"
    else
        printf 'Please use statd to update plugins: statd plugin update theme\n' >&2
        exit 1
    fi
}

# ------------------------------------------------------------
# Main Dispatch
# ------------------------------------------------------------
subcmd="${1:-}"
case "$subcmd" in
    "")
        if [ -t 0 ] && [ -t 1 ]; then
            interactive_picker
        else
            cmd_status
        fi
        ;;
    interactive|select|tui|ui)
        interactive_picker
        ;;
    dance|party)
        trigger_dance_party
        ;;
    status|info)
        cmd_status
        ;;
    list|ls)
        cmd_list
        ;;
    set|apply|use)
        shift
        cmd_set "${1:-}"
        ;;
    preview)
        shift
        cmd_preview "${1:-}"
        ;;
    set-color|color)
        shift
        cmd_set_color "$@"
        ;;
    create|new)
        shift
        cmd_create "${1:-}"
        ;;
    reset|default)
        cmd_reset
        ;;
    update)
        shift
        cmd_update "$@"
        ;;
    -h|--help|help)
        show_help
        ;;
    -v|--version|version)
        printf 'statd-theme %s\n' "$VERSION"
        ;;
    *)
        # If user directly typed: statd theme cyberpunk
        if [ $# -eq 1 ]; then
            cmd_set "$1"
        else
            printf 'Unknown command: %s (see "statd theme --help")\n' "$subcmd" >&2
            exit 1
        fi
        ;;
esac
