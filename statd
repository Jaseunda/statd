LPID=""
LLM_SEED=0
PREV_LLM_TOK=0
PREV_LLM_T=0
LLM_CPU_SEED=0
LLM_TICKS_PREV=0
PREV_LLM_T2=0
PID_SCAN_COUNT=0
PID_INIT=0

SLOW_COUNT=0
SLOW_INIT=0
BATT_PCT=""
BATT_STATUS=""
DISK_TOTAL=0
DISK_USED=0
