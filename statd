_on_off() {
    (( ${1:-1} )) && printf '\033[32mon\033[0m ' || printf '\033[31moff\033[0m'
}

_set_config() {
    local key="$1" val="$2"
    mkdir -p "$CONFIG_DIR"
    touch "$CONFIG_FILE"
    if grep -q "^${key}=" "$CONFIG_FILE" 2>/dev/null; then
        sed -i '' "s|^${key}=.*|${key}=${val}|" "$CONFIG_FILE" 2>/dev/null || \
        sed -i "s|^${key}=.*|${key}=${val}|" "$CONFIG_FILE" 2>/dev/null || true
    else
        printf '%s=%s\n' "$key" "$val" >> "$CONFIG_FILE"
    fi
}

statd_config() {
    mkdir -p "$CONFIG_DIR"
    local subcmd="${1:-}"
    shift || true

    case "$subcmd" in
        disable|off)
            local target="${1:-}"
            target=$(echo "$target" | tr '[:upper:]' '[:lower:]')
            case "$target" in
                ld|load)     _set_config "SHOW_LD" "0" ;;
                bat|battery) _set_config "SHOW_BAT" "0" ;;
                swp|swap)    _set_config "SHOW_SWP" "0" ;;
                dsk|disk)    _set_config "SHOW_DSK" "0" ;;
                cpu)         _set_config "SHOW_CPU" "0" ;;
                ram|mem)     _set_config "SHOW_RAM" "0" ;;
                llm)         _set_config "SHOW_LLM" "0" ;;
                *)
                    printf 'Unknown view: %s (choose: ld, bat, swp, dsk, cpu, ram, llm)\n' "$target" >&2
                    return 1
                    ;;
            esac
            printf '\033[32m+\033[0m  Disabled %s in %s\n' "$target" "$CONFIG_FILE"
            ;;
        enable|on)
            local target="${1:-}"
            target=$(echo "$target" | tr '[:upper:]' '[:lower:]')
            case "$target" in
                ld|load)     _set_config "SHOW_LD" "1" ;;
                bat|battery) _set_config "SHOW_BAT" "1" ;;
                swp|swap)    _set_config "SHOW_SWP" "1" ;;
                dsk|disk)    _set_config "SHOW_DSK" "1" ;;
                cpu)         _set_config "SHOW_CPU" "1" ;;
                ram|mem)     _set_config "SHOW_RAM" "1" ;;
                llm)         _set_config "SHOW_LLM" "1" ;;
                *)
                    printf 'Unknown view: %s (choose: ld, bat, swp, dsk, cpu, ram, llm)\n' "$target" >&2
                    return 1
                    ;;
            esac
            printf '\033[32m+\033[0m  Enabled %s in %s\n' "$target" "$CONFIG_FILE"
            ;;
        set)
            local key="${1:-}" val="${2:-}"
            if [ -z "$key" ] || [ -z "$val" ]; then
                printf 'Usage: statd config set <KEY> <VALUE>\n' >&2
                return 1
            fi
            _set_config "$key" "$val"
            printf '\033[32m+\033[0m  Set %s=%s in %s\n' "$key" "$val" "$CONFIG_FILE"
            ;;
        path)
            printf '%s\n' "$CONFIG_FILE"
            ;;
        edit)
            "${EDITOR:-nano}" "$CONFIG_FILE"
            ;;
        reset)
            rm -f "$CONFIG_FILE"
            printf '\033[32m+\033[0m  Reset configuration (removed %s)\n' "$CONFIG_FILE"
            ;;
        ""|show|list)
            printf '\033[1mstatd configuration\033[0m\n'
            printf 'Config file: %s\n\n' "$CONFIG_FILE"
            printf 'Views:\n'
            printf '  CPU: %s    RAM: %s    SWP: %s    DSK: %s\n' \
                "$(_on_off "$SHOW_CPU")" "$(_on_off "$SHOW_RAM")" "$(_on_off "$SHOW_SWP")" "$(_on_off "$SHOW_DSK")"
            printf '  LD:  %s    BAT: %s    LLM: %s\n\n' \
                "$(_on_off "$SHOW_LD")" "$(_on_off "$SHOW_BAT")" "$(_on_off "$SHOW_LLM")"
            printf 'Commands:\n'
            printf '  statd config disable <view>   (turn off view: ld, bat, swp, dsk, cpu, ram)\n'
            printf '  statd config enable <view>    (turn on view: ld, bat, swp, dsk, cpu, ram)\n'
            printf '  statd config set <KEY> <VAL>  (set any setting, e.g. INTERVAL 2)\n'
            printf '  statd config edit             (open in editor)\n'
            printf '  statd config reset            (reset to defaults)\n'
            ;;
        *)
            printf 'Unknown config command: %s (see "statd config")\n' "$subcmd" >&2
            return 1
            ;;
    esac
}

statd_check_update() {
    printf 'statd %s — checking for updates...\n' "$VERSION"
    local latest_commit=""
    if command -v curl >/dev/null 2>&1; then
        latest_commit=$(curl -fsSL -H "User-Agent: statd" "https://api.github.com/repos/Jaseunda/statd/commits/main" 2>/dev/null | grep '"sha"' | head -1 | cut -d'"' -f4 | cut -c1-7)
    elif command -v wget >/dev/null 2>&1; then
        latest_commit=$(wget -qO- --user-agent="statd" "https://api.github.com/repos/Jaseunda/statd/commits/main" 2>/dev/null | grep '"sha"' | head -1 | cut -d'"' -f4 | cut -c1-7)
    fi
    if [ -n "$latest_commit" ]; then
        printf '  Latest commit on main: %s\n' "$latest_commit"
        printf '  Run "statd --update" to update to the latest version.\n'
    else
        printf '  Unable to check remote commit. Run "statd --update" to attempt update.\n'
    fi
}

statd_update() {
    local script_path
    script_path="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
    printf '\033[1mstatd update\033[0m (current version: %s)\n\n' "$VERSION"

    # 1. If running inside a git checkout, update via git
    if git -C "$script_path" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
        local git_root
        git_root=$(git -C "$script_path" rev-parse --show-toplevel 2>/dev/null)
        printf '  \033[32m+\033[0m  Git repository detected at: %s\n' "$git_root"
        printf '  \033[32m+\033[0m  Pulling latest changes from remote...\n'
        if git -C "$git_root" pull; then
            printf '\n  \033[1;32mstatd updated successfully via git.\033[0m\n'
            return 0
        else
            printf '\n  \033[31mx\033[0m  git pull failed.\n' >&2
            return 1
        fi
    fi

    # 2. Installed binary: update in-place using installer
    local prefix_dir
    if [[ "$script_path" == */bin ]]; then
        prefix_dir="$(dirname "$script_path")"
    else
        prefix_dir="${PREFIX:-$HOME/.local}"
    fi

    printf '  Fetching latest installer from GitHub...\n'
    local branch="${BRANCH:-main}"
    local installer_url="https://raw.githubusercontent.com/Jaseunda/statd/${branch}/install.sh"
    local tmp_installer
    tmp_installer=$(mktemp "${TMPDIR:-/tmp}/statd_update_XXXXXX.sh" 2>/dev/null || mktemp /tmp/statd_update_XXXXXX.sh)

    if command -v curl >/dev/null 2>&1; then
        curl -fsSL "$installer_url" -o "$tmp_installer" || {
            rm -f "$tmp_installer"
            printf '  \033[31mx\033[0m  Failed to download installer from %s\n' "$installer_url" >&2
            return 1
        }
    elif command -v wget >/dev/null 2>&1; then
        wget -qO "$tmp_installer" "$installer_url" || {
            rm -f "$tmp_installer"
            printf '  \033[31mx\033[0m  Failed to download installer from %s\n' "$installer_url" >&2
            return 1
        }
    else
        rm -f "$tmp_installer"
        printf '  \033[31mx\033[0m  curl or wget is required to update.\n' >&2
        return 1
    fi

    printf '  \033[32m+\033[0m  Updating installation at %s ...\n\n' "$prefix_dir"
    PREFIX="$prefix_dir" bash "$tmp_installer" --prefix="$prefix_dir" --update --yes
    local rc=$?
    rm -f "$tmp_installer"
    return $rc
}

# ------------------------------------------------------------
# Plugin system
# ------------------------------------------------------------
find_plugin_bin() {
    local name="$1"
    [ -z "$name" ] && return 1
    local cand
    for cand in \
        "$(pwd)/plugins/$name/statd-$name" \
        "$CONFIG_DIR/plugins/$name/statd-$name" \
        "$CONFIG_DIR/plugins/$name/$name" \
        "$STATD_LIB_DIR/plugins/$name/statd-$name" \
        "$STATD_LIB_DIR/plugins/$name/$name" \
        "$(dirname "$STATD_LIB_DIR")/plugins/$name/statd-$name" \
        "$(dirname "$STATD_LIB_DIR")/plugins/$name/$name"; do
        if [ -x "$cand" ]; then
            printf '%s' "$cand"
            return 0
        fi
    done
    return 1
}

statd_plugin_install() {
    local name="$1"
    if [ -z "$name" ]; then
        printf 'Usage: statd install <plugin>\n'
        printf 'Available plugins:\n'
        printf '  api    Lightweight HTTP JSON & SSE metrics streaming API\n'
        return 1
    fi

    local target_dir="$STATD_LIB_DIR/plugins/$name"
    if [ ! -w "$STATD_LIB_DIR" ] 2>/dev/null; then
        target_dir="$CONFIG_DIR/plugins/$name"
    fi
    mkdir -p "$target_dir"

    printf '  \033[1mInstalling plugin:\033[0m %s\n' "$name"

    # Check local repository source or current working directory first
    local repo_plugin_dir="$(dirname "$STATD_LIB_DIR")/plugins/$name"
    local cwd_plugin_dir="$(pwd)/plugins/$name"
    if [ -d "$repo_plugin_dir" ] && [ -f "$repo_plugin_dir/statd-$name" ]; then
        cp -R "$repo_plugin_dir/"* "$target_dir/"
        chmod +x "$target_dir/statd-$name" 2>/dev/null || true
        printf '  \033[32m+\033[0m  Installed %s to %s\n' "$name" "$target_dir"
    elif [ -d "$cwd_plugin_dir" ] && [ -f "$cwd_plugin_dir/statd-$name" ]; then
        cp -R "$cwd_plugin_dir/"* "$target_dir/"
        chmod +x "$target_dir/statd-$name" 2>/dev/null || true
        printf '  \033[32m+\033[0m  Installed %s to %s\n' "$name" "$target_dir"
    else
        # Download from GitHub repository
        local base_url="https://raw.githubusercontent.com/Jaseunda/statd/main/plugins/$name"
        printf '  \033[32m+\033[0m  Downloading %s from GitHub ...\n' "$name"
        if curl -fsSL "$base_url/statd-$name" -o "$target_dir/statd-$name"; then
            chmod +x "$target_dir/statd-$name"
            curl -fsSL "$base_url/README.md" -o "$target_dir/README.md" 2>/dev/null || true
            printf '  \033[32m+\033[0m  Installed %s to %s\n' "$name" "$target_dir"
        else
            printf '  \033[31mx\033[0m  Failed to download plugin "%s"\n' "$name" >&2
            rm -rf "$target_dir"
            return 1
        fi
    fi

    printf '\n  \033[1;32mPlugin installed successfully!\033[0m\n\n'
    printf '  Run:    statd %s --help\n' "$name"
    printf '  Start:  statd %s\n\n' "$name"
    return 0
}

statd_plugin_remove() {
    local name="$1"
    if [ -z "$name" ]; then
        printf 'Usage: statd remove <plugin>\n'
        return 1
    fi
    local removed=0
    for d in "$STATD_LIB_DIR/plugins/$name" "$CONFIG_DIR/plugins/$name"; do
        if [ -d "$d" ]; then
            rm -rf "$d"
            printf '  \033[32m+\033[0m  Removed %s\n' "$d"
            removed=1
        fi
    done
    if (( removed )); then
        printf '  Plugin "%s" uninstalled.\n' "$name"
    else
        printf '  Plugin "%s" is not installed.\n' "$name"
    fi
    return 0
}

statd_plugin_list() {
    printf '\n  \033[1mStatD Plugins\033[0m\n\n'
    local api_bin
    api_bin=$(find_plugin_bin "api" 2>/dev/null || true)
    if [ -n "$api_bin" ]; then
        printf '  \033[32m●\033[0m  \033[1mapi\033[0m       Lightweight HTTP JSON & SSE metrics streaming API  \033[32m[installed]\033[0m\n'
        printf '            Run: statd api (or statd api --help)\n'
    else
        printf '  \033[2m○\033[0m  \033[1mapi\033[0m       Lightweight HTTP JSON & SSE metrics streaming API  \033[2m[available]\033[0m\n'
        printf '            Install: statd install api\n'
    fi
    printf '\n'
}

# ------------------------------------------------------------
# Command line options & Plugin Dispatch
# ------------------------------------------------------------
if [ -n "${1:-}" ]; then
    _plug_bin=$(find_plugin_bin "$1" 2>/dev/null || true)
    if [ -n "$_plug_bin" ] && [ -x "$_plug_bin" ]; then
        shift
        exec "$_plug_bin" "$@"
    fi
fi

while [[ $# -gt 0 ]]; do
    case "$1" in
        install)
            shift
            statd_plugin_install "$@"
            exit $?
            ;;
        remove|uninstall)
            shift
            statd_plugin_remove "$@"
            exit $?
            ;;
        plugins|plugin)
            shift
            case "${1:-}" in
                install)
                    shift
                    statd_plugin_install "$@"
                    exit $?
                    ;;
                remove|uninstall)
                    shift
                    statd_plugin_remove "$@"
                    exit $?
                    ;;
                *)
                    statd_plugin_list
                    exit 0
                    ;;
            esac
            ;;
        api)
            printf '  \033[33m!\033[0m  Plugin "api" is not installed.\n'
            printf '     Install it with:  statd install api\n\n'
            exit 1
            ;;
        config)
            shift
            statd_config "$@"
            exit $?
            ;;
        --config)
            shift
            statd_config "$@"
            exit $?
            ;;
        --no-ld|--hide-ld)
            SHOW_LD=0
            shift
            ;;
        --no-bat|--hide-bat)
            SHOW_BAT=0
            shift
            ;;
        --no-swp|--hide-swp)
            SHOW_SWP=0
            shift
            ;;
        --no-dsk|--hide-dsk)
            SHOW_DSK=0
            shift
            ;;
        --no-cpu)
            SHOW_CPU=0
            shift
            ;;
        --no-ram)
            SHOW_RAM=0
            shift
            ;;
        -u|--update|update)
            statd_update
            exit $?
            ;;
        --check-update)
            statd_check_update
            exit $?
            ;;
        -v|--version|version)
            printf 'statd %s (bash %s)\n' "$VERSION" "$BASH_VERSION"
            exit 0
            ;;
        -h|--help|help)
            show_help
            exit 0
            ;;
        -c|--cores)
            CORES_SHOWN=1
            shift
            ;;
        -i|--interval)
            if [[ -n "${2:-}" ]] && [[ "$2" =~ ^[0-9]+(\.[0-9]+)?$ ]]; then
                INTERVAL="$2"
                shift 2
            else
                printf 'statd: invalid or missing interval value\n' >&2
                exit 1
            fi
            ;;
        *)
            printf 'statd: unrecognized option: %s (see statd --help)\n' "$1" >&2
            exit 1
            ;;
    esac
done

# ------------------------------------------------------------
# Lifecycle
# ------------------------------------------------------------
NEED_FULL_REDRAW=0
handle_winch() {
    NEED_FULL_REDRAW=1
}
trap handle_winch WINCH

cleanup() {
    printf '%s\033[?25h\n' "$C_RESET"
    exit 0
}
trap cleanup INT TERM

PREV_TERM_LINES=0
PREV_TERM_COLS=0

printf '\033[?25l'
clear

# ============================================================
# Main loop
# ============================================================
while true; do

    # ---- Detect terminal geometry ----
    if [ -t 1 ]; then
        TERM_LINES=$(tput lines 2>/dev/null || echo "${LINES:-24}")
        TERM_COLS=$(tput cols 2>/dev/null || echo "${COLUMNS:-80}")
    else
        TERM_LINES=24
        TERM_COLS=80
    fi
    [[ "$TERM_LINES" =~ ^[0-9]+$ ]] || TERM_LINES=24
    [[ "$TERM_COLS" =~ ^[0-9]+$ ]] || TERM_COLS=80

    if (( NEED_FULL_REDRAW || TERM_LINES != PREV_TERM_LINES || TERM_COLS != PREV_TERM_COLS )); then
        printf '\033[2J\033[H'
        PREV_LINES=()
        PREV_NLINES=0
        NEED_FULL_REDRAW=0
        PREV_TERM_LINES=$TERM_LINES
        PREV_TERM_COLS=$TERM_COLS
    fi

    # ---- Memory ----
    read -r MEM_TOTAL MEM_USED SWAP_TOTAL SWAP_USED <<< "$(get_memory)"
    MEM_TOTAL_B=$(( MEM_TOTAL * 1024 ))
    MEM_USED_B=$(( MEM_USED  * 1024 ))
    SWAP_TOTAL_B=$(( SWAP_TOTAL * 1024 ))
    SWAP_USED_B=$(( SWAP_USED  * 1024 ))
    (( MEM_TOTAL  > 0 )) && MEM_PCT=$(( MEM_USED  * 100 / MEM_TOTAL  )) || MEM_PCT=0
    (( SWAP_TOTAL > 0 )) && SWAP_PCT=$(( SWAP_USED * 100 / SWAP_TOTAL )) || SWAP_PCT=0

    # ---- Timing ----
    NOW=$(date +%s%N)
    DT_US=$(( (NOW - PREV_CPU_TIME) / 1000 ))

    # ---- CPU% ----
    CPU='--'
    read -r CPU_TOTAL CPU_IDLE <<< "$(get_cpu_raw)"
    if [[ "$CPU_TOTAL" == "PCT" ]]; then
        CPU="$CPU_IDLE"
        [[ "$CPU" =~ ^[0-9]+$ ]] || CPU=0
        (( CPU < 0 )) && CPU=0
        (( CPU > 100 )) && CPU=100
    elif [[ "$CPU_TOTAL" =~ ^[0-9]+$ ]]; then
        if (( PREV_CPU_TOTAL > 0 )); then
            C_DT=$(( CPU_TOTAL - PREV_CPU_TOTAL ))
            C_IDLE=$(( CPU_IDLE - PREV_CPU_IDLE ))
            if (( C_DT > 0 )); then
                CPU=$(( (C_DT - C_IDLE) * 100 / C_DT ))
                (( CPU <   0 )) && CPU=0
                (( CPU > 100 )) && CPU=100
            else
                CPU=0
            fi
        fi
        PREV_CPU_TOTAL=$CPU_TOTAL
        PREV_CPU_IDLE=$CPU_IDLE
    fi

    # Linux fallback: cpuidle residency when /proc/stat is unavailable.
    if [[ "$CPU" == '--' ]] && [ "$OS_TYPE" = "linux" ]; then
        IDLE_US=$(get_idle_us)
        if (( IDLE_US > 0 && PREV_IDLE_US > 0 && IDLE_US >= PREV_IDLE_US && DT_US > 0 )); then
            CAP_US=$(( DT_US * NCPU ))
            BUSY_US=$(( CAP_US - (IDLE_US - PREV_IDLE_US) ))
            (( BUSY_US < 0 )) && BUSY_US=0
            CPU=$(( BUSY_US * 100 / CAP_US ))
            (( CPU > 100 )) && CPU=100
        fi
        (( IDLE_US > 0 )) && PREV_IDLE_US=$IDLE_US
    fi

    # ---- Per-core % (Linux cpuidle residency; macOS shows placeholder) ----
    declare -a CUR_I=()
    if [ "$OS_TYPE" = "linux" ]; then
        while read -r c v; do
            [[ "$c" =~ ^[0-9]+$ ]] && CUR_I[$c]=$v
        done < <(get_core_idle)
    fi

    declare -a CORE_PCT=()
    for (( c=0; c<NCPU; c++ )); do
        pv=${PREV_CORE_I[$c]:-0}
        cv=${CUR_I[$c]:-0}
        cpc='--'
        if [ "$OS_TYPE" = "linux" ] && (( DT_US >= 200000 && pv > 0 && cv >= pv )); then
            didle=$(( cv - pv ))
            busy=$(( (DT_US - didle) * 100 / DT_US ))
            (( busy <   0 )) && busy=0
            (( busy > 100 )) && busy=100
            cpc=$busy
        fi
        CORE_PCT[$c]=$cpc
    done
    for c in "${!CUR_I[@]}"; do PREV_CORE_I[$c]=${CUR_I[$c]}; done
    PREV_CPU_TIME=$NOW

    FREQ=$(get_cpu_freq)
    TEMP=$(get_temp)

    # ---- LLM: llama-server tok/s via /metrics ----
    TPS_STR=''
    MOUT=$(get_llama_metrics || true)
    if [ -n "$MOUT" ]; then
        PTOK=$(printf '%s\n' "$MOUT" \
            | awk '$1 ~ /^llama_predicted_tokens_total/ {printf "%d", $NF; exit}' 2>/dev/null)
    else
        PTOK=''
    fi
    if [[ "$PTOK" =~ ^[0-9]+$ ]]; then
        if (( LLM_SEED && PTOK >= PREV_LLM_TOK )); then
            D_MS_L=$(( (NOW - PREV_LLM_T) / 1000000 ))
            (( D_MS_L < 200 )) && D_MS_L=200
            TPS10=$(( (PTOK - PREV_LLM_TOK) * 10000 / D_MS_L ))
            TPS_STR="$(printf '%d.%d' $(( TPS10 / 10 )) $(( TPS10 % 10 )))"
        fi
        PREV_LLM_TOK=$PTOK
        PREV_LLM_T=$NOW
        LLM_SEED=1
    else
        LLM_SEED=0
    fi

    # ---- LLM: fallback process CPU% + RSS ----
    LCPU_STR=''
    RSS_STR=''
    if ! llama_pid_alive "$LPID"; then
        LPID=""
        LLM_CPU_SEED=0
        LLM_TICKS_PREV=0
    fi
    if [ -z "$LPID" ]; then
        PID_SCAN_COUNT=$(( PID_SCAN_COUNT + 1 ))
        if (( PID_INIT == 0 || PID_SCAN_COUNT >= PID_SCAN_EVERY )); then
            LPID=$(find_llama_pid)
            PID_SCAN_COUNT=0
            PID_INIT=1
        fi
    fi

    if [ -n "$LPID" ]; then
        read -r L_TICKS L_RSS <<< "$(get_llama_proc_stats "$LPID")"
        if [[ "$L_TICKS" =~ ^[0-9]+$ ]]; then
            if [ "$OS_TYPE" = "macos" ]; then
                # macOS: get_llama_proc_stats returns instantaneous pcpu + rss_kB
                LC=$L_TICKS
                [[ "$LC" =~ ^[0-9]+$ ]] && (( LC > 999 )) && LC=999
                LCPU_STR="$LC"
            else
                if (( LLM_CPU_SEED )); then
                    D_TICKS=$(( L_TICKS - LLM_TICKS_PREV ))
                    D_MS=$(( (NOW - PREV_LLM_T2) / 1000000 ))
                    if (( D_MS >= 200 && D_TICKS >= 0 )); then
                        LC=$(( D_TICKS * 100000 / (CLK_TCK * D_MS) ))
                        (( LC > 999 )) && LC=999
                        LCPU_STR="$LC"
                    fi
                fi
            fi
            LLM_TICKS_PREV=$L_TICKS
            PREV_LLM_T2=$NOW
            LLM_CPU_SEED=1
        fi
        if [[ "$L_RSS" =~ ^[0-9]+$ ]] && (( L_RSS > 0 )); then
            if [ "$OS_TYPE" = "macos" ]; then
                RSS_STR=$(human $(( L_RSS * 1024 )))     # ps rss is in kB on macOS
            else
                RSS_STR=$(human $(( L_RSS * PAGE_SIZE ))) # /proc rss is in pages on Linux
            fi
        fi
    fi

    # ---- Load average ----
    L1='--'; L5='--'; L15='--'; NPROC=''; LD_PCT=''
    read -r L1 L5 L15 RUNTOT <<< "$(get_loadavg)"
    if [[ "$L1" =~ ^[0-9]+\.[0-9][0-9]$ \
       && "$L5" =~ ^[0-9]+\.[0-9][0-9]$ \
       && "$L15" =~ ^[0-9]+\.[0-9][0-9]$ ]]; then
        L100=${L1/./}
        LD_PCT=$(( L100 / NCPU ))
        (( LD_PCT > 100 )) && LD_PCT=100
        NPROC="${RUNTOT##*/}"
    else
        L1='--'; L5='--'; L15='--'
    fi

    # ---- Slow tier: battery, disk, uptime (refreshed every SLOW_EVERY s) ----
    SLOW_COUNT=$(( SLOW_COUNT + 1 ))
    if (( SLOW_INIT == 0 || SLOW_COUNT >= SLOW_EVERY )); then
        read -r DISK_TOTAL DISK_USED <<< "$(get_disk)"
        (( DISK_TOTAL > 0 )) \
            && DISK_PCT=$(( DISK_USED * 100 / DISK_TOTAL )) \
            || DISK_PCT=0
        read -r BATT_PCT BATT_STATUS <<< "$(get_battery)"
        UP=$(get_uptime)
        SLOW_COUNT=0
        SLOW_INIT=1
    fi

    # ---- Temperature color ----
    if [[ "$TEMP" =~ ^[0-9]+$ ]]; then
        if   (( TEMP < 40 )); then TEMP_COLOR=$C_GREEN
        elif (( TEMP < 55 )); then TEMP_COLOR=$C_YELLOW
        else                       TEMP_COLOR=$C_RED
        fi
        TEMP_STR="${TEMP}C"
    else
        TEMP_COLOR="$C_GREY"
        TEMP_STR="--"
    fi

    # ============================================================
    # Build frame
    # ============================================================
    declare -a LEFTP=() LEFTC=() VALP=() VALC=() ROWPCT=() ROWMODE=()

    if (( SHOW_CPU )); then
        row_start
        seg "CPU" "$C_BOLD"
        seg " $(printf '%3s' "$CPU")" "$(pct_color "$CPU")"
        seg "%  " ""
        LEFTP+=("$ROW_PLAIN"); LEFTC+=("$ROW_COLORED")
        row_start
        seg "$FREQ" "$C_BLUE"
        seg "  " ""
        seg "$TEMP_STR" "$TEMP_COLOR"
        VALP+=("$ROW_PLAIN"); VALC+=("$ROW_COLORED"); ROWPCT+=("$CPU"); ROWMODE+=("load")
    fi

    if (( SHOW_RAM )); then
        row_start
        seg "RAM" "$C_BOLD"
        seg " $(printf '%3d' "$MEM_PCT")" "$(pct_color "$MEM_PCT")"
        seg "%  " ""
        LEFTP+=("$ROW_PLAIN"); LEFTC+=("$ROW_COLORED")
        row_start
        seg "$(human "$MEM_USED_B")/$(human "$MEM_TOTAL_B")" "$C_DIM"
        VALP+=("$ROW_PLAIN"); VALC+=("$ROW_COLORED"); ROWPCT+=("$MEM_PCT"); ROWMODE+=("load")
    fi

    if (( SHOW_SWP )); then
        row_start
        seg "SWP" "$C_BOLD"
        seg " $(printf '%3d' "$SWAP_PCT")" "$C_MAG"
        seg "%  " ""
        LEFTP+=("$ROW_PLAIN"); LEFTC+=("$ROW_COLORED")
        row_start
        seg "$(human "$SWAP_USED_B")/$(human "$SWAP_TOTAL_B")" "$C_MAG"
        VALP+=("$ROW_PLAIN"); VALC+=("$ROW_COLORED"); ROWPCT+=("$SWAP_PCT"); ROWMODE+=("mag")
    fi

    if (( SHOW_DSK )); then
        row_start
        seg "DSK" "$C_BOLD"
        seg " $(printf '%3d' "$DISK_PCT")" "$(pct_color "$DISK_PCT")"
        seg "%  " ""
        LEFTP+=("$ROW_PLAIN"); LEFTC+=("$ROW_COLORED")
        row_start
        seg "$(human "$DISK_USED")/$(human "$DISK_TOTAL")" "$C_DIM"
        VALP+=("$ROW_PLAIN"); VALC+=("$ROW_COLORED"); ROWPCT+=("$DISK_PCT"); ROWMODE+=("load")
    fi

    if (( SHOW_LD )) && [[ "$LD_PCT" =~ ^[0-9]+$ ]]; then
        row_start
        seg "LD" "$C_BOLD"
        seg " $(printf '%3d' "$LD_PCT")" "$(pct_color "$LD_PCT")"
        seg "%  " ""
        LEFTP+=("$ROW_PLAIN"); LEFTC+=("$ROW_COLORED")
        row_start
        if (( TERM_COLS >= 32 )); then
            seg "$L1 $L5 $L15  ${NPROC}p" "$C_DIM"
        else
            seg "$L1 $L5 $L15" "$C_DIM"
        fi
        VALP+=("$ROW_PLAIN"); VALC+=("$ROW_COLORED"); ROWPCT+=("$LD_PCT"); ROWMODE+=("load")
    fi

    VALMAX=0
    LEFTW=0
    for v in "${VALP[@]}"; do (( ${#v} > VALMAX )) && VALMAX=${#v}; done
    for l in "${LEFTP[@]}"; do (( ${#l} > LEFTW )) && LEFTW=${#l}; done
    TOTALW=$(( LEFTW + VALMAX ))
    (( TOTALW < BAR_WIDTH )) && TOTALW=$BAR_WIDTH
    if (( TERM_COLS > 10 )) && (( TOTALW > TERM_COLS )); then
        TOTALW=$TERM_COLS
    fi

    # ---- Per-core panel ----
    CORE_ROWS=()
    if (( CORES_SHOWN )); then
        MAX_PER_ROW=$(( TOTALW - 2 ))
        (( MAX_PER_ROW < 8 )) && MAX_PER_ROW=8

        case "$CORE_STYLE" in
            dots)
                line="${C_GREY}c ${C_RESET}"
                row_cnt=0
                for (( c=0; c<NCPU; c++ )); do
                    if (( row_cnt >= MAX_PER_ROW )); then
                        CORE_ROWS+=("${line}${C_RESET}")
                        line="  "
                        row_cnt=0
                    fi
                    p="${CORE_PCT[$c]:---}"
                    if [[ "$p" =~ ^[0-9]+$ ]]; then
                        line+="$(pct_color "$p")\xe2\x97\x8f"
                    else
                        line+="${C_GREY}\xc2\xb7"
                    fi
                    (( row_cnt++ ))
                done
                CORE_ROWS+=("${line}${C_RESET}")
                ;;
            spark)
                SPK=(' ' '▂' '▃' '▄' '▅' '▆' '▇' '█')
                line="${C_GREY}c ${C_RESET}"
                row_cnt=0
                for (( c=0; c<NCPU; c++ )); do
                    if (( row_cnt >= MAX_PER_ROW )); then
                        CORE_ROWS+=("${line}${C_RESET}")
                        line="  "
                        row_cnt=0
                    fi
                    p="${CORE_PCT[$c]:---}"
                    if [[ "$p" =~ ^[0-9]+$ ]]; then
                        idx=$(( p * 8 / 100 ))
                        (( idx > 7 )) && idx=7
                        char="${SPK[$idx]}"
                        line+="$(pct_color "$p")${char}"
                    else
                        line+="${C_GREY}\xc2\xb7"
                    fi
                    (( row_cnt++ ))
                done
                CORE_ROWS+=("${line}${C_RESET}")
                ;;
            seg)
                WT=$(( TOTALW - 2 ))
                (( WT < NCPU )) && WT=$NCPU
                BASE=$(( WT / NCPU ))
                REM=$(( WT % NCPU ))
                line="${C_GREY}\xe2\x94\x94 ${C_RESET}"
                for (( c=0; c<NCPU; c++ )); do
                    w=$BASE
                    (( c < REM )) && w=$(( w + 1 ))
                    line+="$(bar_gradient "${CORE_PCT[$c]}" "$w" load)"
                done
                CORE_ROWS+=("$line")
                ;;
            mini)
                HALF=$(( (NCPU + 1) / 2 ))
                for (( r=0; r<HALF; r++ )); do
                    lc=$r
                    rc=$(( r + HALF ))
                    line="$(core_cell "$lc" "${CORE_PCT[$lc]:---}")"
                    if (( rc < NCPU )); then
                        line+="   $(core_cell "$rc" "${CORE_PCT[$rc]:---}")"
                    fi
                    CORE_ROWS+=("$line")
                done
                ;;
        esac
    fi

    # ---- Header: clock + uptime ----
    CLOCK="$(date +%H:%M:%S)"
    UPTXT="up $UP"
    pad=$(( TOTALW - ${#CLOCK} - ${#UPTXT} ))
    if (( pad < 1 )); then
        if (( ${#UPTXT} > 6 )) && (( ${#CLOCK} + ${#UPTXT} >= TOTALW )); then
            UPTXT="${UPTXT// /}"
            pad=$(( TOTALW - ${#CLOCK} - ${#UPTXT} ))
        fi
        (( pad < 1 )) && pad=1
    fi

    FRAME=()
    FRAME+=("$(printf '%s%s%*s%s%s' "$C_DIM" "$CLOCK" "$pad" "" "$UPTXT" "$C_RESET")")

    for i in "${!LEFTP[@]}"; do
        pad=$(( VALMAX - ${#VALP[$i]} ))
        (( pad < 0 )) && pad=0
        FRAME+=("$(printf '%s%*s%s' "${LEFTC[$i]}" "$pad" "" "${VALC[$i]}")")
        FRAME+=("$(bar_gradient "${ROWPCT[$i]}" "$TOTALW" "${ROWMODE[$i]}")")
        if (( i == 0 )) && (( ${#CORE_ROWS[@]} > 0 )); then
            for r in "${CORE_ROWS[@]}"; do FRAME+=("$r"); done
        fi
    done

    # ---- LLM row ----
    if (( SHOW_LLM )) && { [ -n "$TPS_STR" ] || [ -n "$LCPU_STR" ] || [ -n "$RSS_STR" ]; }; then
        row_start
        seg "LLM" "$C_BOLD"
        [ -n "$TPS_STR" ]  && seg " ${TPS_STR} t/s" "$C_CYAN"
        [ -n "$LCPU_STR" ] && { seg "  " ""; seg "${LCPU_STR}%" "$(pct_color "$LCPU_STR")"; }
        [ -n "$RSS_STR" ]  && seg "  ${RSS_STR}" "$C_DIM"
        (( ${#ROW_PLAIN} > 3 )) && FRAME+=("$ROW_COLORED")
    fi

    # ---- Battery row ----
    if (( SHOW_BAT )) && [ -n "$BATT_PCT" ]; then
        row_start
        seg "BAT" "$C_BOLD"
        seg " $(printf '%3d' "$BATT_PCT")" "$(pct_color $(( 100 - BATT_PCT )))"
        seg "%  " ""
        seg "$BATT_STATUS" "$C_DIM"
        FRAME+=("$ROW_COLORED")
    fi

    # ============================================================
    # Prevent height overflow: never exceed available terminal rows
    # ============================================================
    MAX_LINES=$(( TERM_LINES > 1 ? TERM_LINES - 1 : 1 ))
    if (( ${#FRAME[@]} > MAX_LINES )); then
        FRAME=("${FRAME[@]:0:$MAX_LINES}")
    fi

    # ============================================================
    # Dirty-line diff render — only rewrite lines that changed
    # ============================================================
    OUT=''
    NEW_N=${#FRAME[@]}
    for (( i=0; i<NEW_N; i++ )); do
        if (( i < PREV_NLINES )) && [[ "${FRAME[i]}" == "${PREV_LINES[i]}" ]]; then
            continue
        fi
        printf -v CHUNK '\033[%d;1H\033[K%s' $(( i + 1 )) "${FRAME[i]}"
        OUT+=$CHUNK
    done
    if (( NEW_N < PREV_NLINES )); then
        printf -v CHUNK '\033[%d;1H\033[J' $(( NEW_N + 1 ))
        OUT+=$CHUNK
    fi
    OUT+=$'\033[1;1H'
    [[ -n "$OUT" ]] && printf '%s' "$OUT"
    PREV_LINES=("${FRAME[@]}")
    PREV_NLINES=$NEW_N

    # ============================================================
    # Wait INTERVAL seconds; wake early on keypress
    # ============================================================
    T_END=$(( $(date +%s%N) + INTERVAL * 1000000000 ))
    while :; do
        CUR_T=$(date +%s%N)
        (( CUR_T >= T_END )) && break
        key=''
        if [ -t 0 ]; then
            if [ -n "$READ_TIMEOUT" ]; then
                IFS= read -rsn1 -t "$READ_TIMEOUT" key 2>/dev/null || true
            else
                IFS= read -rsn1 -t 1 key 2>/dev/null || true
            fi
        else
            sleep 0.1
        fi
        case "$key" in
            c|C) CORES_SHOWN=$(( 1 - CORES_SHOWN )); break ;;
            l|L) SHOW_LD=$(( 1 - SHOW_LD )); break ;;
            b|B) SHOW_BAT=$(( 1 - SHOW_BAT )); break ;;
            s|S) SHOW_SWP=$(( 1 - SHOW_SWP )); break ;;
            d|D) SHOW_DSK=$(( 1 - SHOW_DSK )); break ;;
            q|Q) cleanup ;;
        esac
    done

done