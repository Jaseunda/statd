#!/usr/bin/env bash
# statd — minimal terminal system stats HUD
# https://github.com/Jaseunda/statd
# MIT License

set -o pipefail

# Ensure Bash 4.0 or later (macOS ships Bash 3.2 by default)
if (( BASH_VERSINFO[0] < 4 )); then
    for _b in /opt/homebrew/bin/bash /usr/local/bin/bash; do
        if [ -x "$_b" ]; then
            _bv=$("$_b" -c 'echo ${BASH_VERSINFO[0]}' 2>/dev/null || echo 0)
            if (( _bv >= 4 )); then
                exec "$_b" "$0" "$@"
            fi
        fi
    done
    _candidate=$(type -a -p bash 2>/dev/null | while read -r p; do
        if [ -x "$p" ]; then
            _bv=$("$p" -c 'echo ${BASH_VERSINFO[0]}' 2>/dev/null || echo 0)
            if (( _bv >= 4 )); then
                echo "$p"
                break
            fi
        fi
    done)
    if [ -n "$_candidate" ]; then
        exec "$_candidate" "$0" "$@"
    fi

    printf 'statd: Bash 4.0+ is required (running under Bash %s).\n' "$BASH_VERSION" >&2
    if [[ "$(uname -s)" == "Darwin" ]]; then
        printf 'On macOS: brew install bash\n' >&2
    fi
    exit 1
fi

VERSION="0.1.1"

# ------------------------------------------------------------
# Locate the lib directory (supports in-tree dev and installed)
# ------------------------------------------------------------
# BEGIN LIB LOADER
_SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
_PREFIX_DIR="$(dirname "$_SCRIPT_DIR")"
_LIB_DIR=""

for _d in \
    "$_SCRIPT_DIR/lib" \
    "$_PREFIX_DIR/lib/statd" \
    "/usr/local/lib/statd" \
    "/opt/homebrew/lib/statd" \
    "/usr/lib/statd" \
    "/usr/share/statd/lib"
do
    if [ -d "$_d" ]; then
        _LIB_DIR="$_d"
        break
    fi
done

if [ -z "$_LIB_DIR" ]; then
    printf 'statd: cannot locate lib directory\n' >&2
    exit 1
fi

unset _d _SCRIPT_DIR _PREFIX_DIR

# Source order matters: platform libs first, then the dispatcher layer.
# shellcheck source=lib/colors.sh
source "$_LIB_DIR/colors.sh"
# shellcheck source=lib/render.sh
source "$_LIB_DIR/render.sh"
# shellcheck source=lib/sensors_linux.sh
source "$_LIB_DIR/sensors_linux.sh"
# shellcheck source=lib/sensors_macos.sh
source "$_LIB_DIR/sensors_macos.sh"
# shellcheck source=lib/sensors.sh
source "$_LIB_DIR/sensors.sh"
# shellcheck source=lib/llm.sh
source "$_LIB_DIR/llm.sh"

STATD_LIB_DIR="$_LIB_DIR"
unset _LIB_DIR
# END LIB LOADER

# ------------------------------------------------------------
# Configuration (loaded from ~/.config/statd/config, env, or CLI)
# ------------------------------------------------------------
CONFIG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/statd"
CONFIG_FILE="$CONFIG_DIR/config"

# View toggles (1 = show, 0 = hide)
SHOW_CPU=1
SHOW_RAM=1
SHOW_SWP=1
SHOW_DSK=1
SHOW_LD=1
SHOW_BAT=1
SHOW_LLM=1

# Defaults
INTERVAL=1
SLOW_EVERY=30
PID_SCAN_EVERY=5
BAR_WIDTH=20
CORE_BAR_W=5
CORE_STYLE="spark"
CORES_SHOWN=0
LLM_PORT=8080

# Source persistent config file if present
if [ -f "$CONFIG_FILE" ]; then
    # shellcheck source=/dev/null
    source "$CONFIG_FILE" 2>/dev/null || true
fi

# Environment variable overrides
INTERVAL="${INTERVAL:-1}"
SLOW_EVERY="${SLOW_EVERY:-30}"
PID_SCAN_EVERY="${PID_SCAN_EVERY:-5}"
BAR_WIDTH="${BAR_WIDTH:-20}"
CORE_BAR_W="${CORE_BAR_W:-5}"
CORE_STYLE="${CORE_STYLE:-spark}"
CORES_SHOWN="${CORES_SHOWN:-0}"
LLM_PORT="${LLM_PORT:-8080}"
SHOW_CPU="${SHOW_CPU:-1}"
SHOW_RAM="${SHOW_RAM:-1}"
SHOW_SWP="${SHOW_SWP:-1}"
SHOW_DSK="${SHOW_DSK:-1}"
SHOW_LD="${SHOW_LD:-1}"
SHOW_BAT="${SHOW_BAT:-1}"
SHOW_LLM="${SHOW_LLM:-1}"

READ_TIMEOUT="0.1"
if ! read -t 0.1 _test_to </dev/null 2>/dev/null; then
    READ_TIMEOUT=""
fi

