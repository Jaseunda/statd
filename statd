#!/usr/bin/env bash
# statd — minimal terminal system stats HUD
# https://github.com/Jaseunda/statd
# MIT License

set -o pipefail
shopt -s checkwinsize 2>/dev/null || true

# Ensure Bash 4.0 or later (macOS ships Bash 3.2 by default)
if (( BASH_VERSINFO[0] < 4 )); then
    for _b in /opt/homebrew/bin/bash /usr/local/bin/bash; do
        if [ -x "$_b" ]; then
            _bv=$("$_b" -c 'echo ${BASH_VERSINFO[0]}' 2>/dev/null || echo 0)
            if (( _bv >= 4 )); then
                exec "$_b" "$0" "$@"
            fi
        fi
    done
    _candidate=$(type -a -p bash 2>/dev/null | while read -r p; do
        if [ -x "$p" ]; then
            _bv=$("$p" -c 'echo ${BASH_VERSINFO[0]}' 2>/dev/null || echo 0)
            if (( _bv >= 4 )); then
                echo "$p"
                break
            fi
        fi
    done)
    if [ -n "$_candidate" ]; then
        exec "$_candidate" "$0" "$@"
    fi

    printf 'statd: Bash 4.0+ is required (running under Bash %s).\n' "$BASH_VERSION" >&2
    if [[ "$(uname -s)" == "Darwin" ]]; then
        printf 'On macOS: brew install bash\n' >&2
    fi
    exit 1
fi

VERSION="0.1.1"

# ------------------------------------------------------------
# Locate the lib directory (supports in-tree dev and installed)
# ------------------------------------------------------------
# BEGIN LIB LOADER
_SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
_PREFIX_DIR="$(dirname "$_SCRIPT_DIR")"
_LIB_DIR=""

for _d in \
    "$_SCRIPT_DIR/lib" \
    "$_PREFIX_DIR/lib/statd" \
    "$HOME/.local/lib/statd" \
    "${PREFIX:-}/lib/statd" \
    "/data/data/com.termux/files/usr/lib/statd" \
    "/usr/local/lib/statd" \
    "/opt/homebrew/lib/statd" \
    "/usr/lib/statd" \
    "/usr/share/statd/lib"
do
    if [ -f "$_d/sensors.sh" ] && [ -f "$_d/render.sh" ]; then
        _LIB_DIR="$_d"
        break
    fi
done

if [ -z "$_LIB_DIR" ]; then
    printf 'statd: cannot locate required library files (sensors.sh, render.sh)\n' >&2
    printf 'If running standalone, use dist/statd or install via:\n' >&2
    printf '  curl -fsSL https://raw.githubusercontent.com/Jaseunda/statd/main/install.sh | bash\n' >&2
    exit 1
fi

unset _d _SCRIPT_DIR _PREFIX_DIR

# Source order matters: platform libs first, then the dispatcher layer.
for _f in colors.sh render.sh sensors_linux.sh sensors_macos.sh sensors.sh llm.sh; do
    if [ ! -f "$_LIB_DIR/$_f" ]; then
        printf 'statd: missing required library: %s/%s\n' "$_LIB_DIR" "$_f" >&2
        exit 1
    fi
    # shellcheck source=/dev/null
    source "$_LIB_DIR/$_f" || {
        printf 'statd: failed to source %s/%s\n' "$_LIB_DIR" "$_f" >&2
        exit 1
    }
done

STATD_LIB_DIR="$_LIB_DIR"
unset _LIB_DIR _f
# END LIB LOADER

# ------------------------------------------------------------
# Configuration (loaded from ~/.config/statd/config, env, or CLI)
# ------------------------------------------------------------
CONFIG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/statd"
CONFIG_FILE="$CONFIG_DIR/config"

